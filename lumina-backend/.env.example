# ==============================================================================
# lumina-backend — variáveis de ambiente
# ==============================================================================
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA faça commit do arquivo `.env` (já está no .gitignore).
# ==============================================================================

# --- Banco de dados -----------------------------------------------------------

# DATABASE_URL
# String de conexão do PostgreSQL usada pelo Prisma Client em tempo de
# execução (queries da aplicação) e pelo Prisma Migrate para aplicar as
# migrations neste banco.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL=

# SHADOW_DATABASE_URL (opcional, recomendado em desenvolvimento)
# Banco auxiliar e temporário que o Prisma Migrate usa para detectar drift de
# schema ao rodar `prisma migrate dev`. Deve ser um banco PostgreSQL vazio,
# separado do banco principal. Não é necessária para `migrate deploy`.
SHADOW_DATABASE_URL=

# --- Aplicação ------------------------------------------------------------------

# PORT
# Porta em que o servidor HTTP do NestJS vai escutar.
# Sugestão: 3001 (o lumina-landing usa 5173 e o lumina-app usa 5174).
PORT=3001

# CORS_ORIGIN
# Lista de origens (separadas por vírgula) autorizadas a chamar esta API a
# partir do navegador. Sem isso, o lumina-app não consegue fazer login/registro
# via fetch/axios (o navegador bloqueia por CORS). Em produção, deve conter a
# URL real do app publicado (ex: https://app.lumina.com.br).
# Sugestão para desenvolvimento local:
CORS_ORIGIN=http://localhost:5174

# FRONTEND_URL
# URL base do lumina-app. Usada para redirecionar o navegador de volta pro
# frontend ao final do login com Google (GET /auth/google/callback), com os
# tokens na query string da rota /oauth/callback.
# Sugestão para desenvolvimento local:
FRONTEND_URL=http://localhost:5174

# --- Rate limit -------------------------------------------------------------
# Limite global por endereço IP. Por padrão, cada cliente pode fazer até
# 100 requisições em uma janela de 60 segundos.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# --- JWT --------------------------------------------------------------------

# JWT_SECRET
# Chave usada para assinar e validar os Access Tokens (JWT) emitidos no
# login/registro. Deve ser uma string longa e aleatória (ex: gerada com
# `openssl rand -hex 32`). Se vazar, qualquer pessoa pode forjar tokens
# válidos — nunca reaproveitar em outro ambiente/projeto.
JWT_SECRET=

# JWT_EXPIRES_IN
# Tempo de validade do Access Token. Formato aceito pela lib `jsonwebtoken`
# (ex: "15m", "1h", "7d"). Access tokens costumam ter vida curta.
# Sugestão:
JWT_EXPIRES_IN=15m

# JWT_REFRESH_SECRET
# Chave usada para assinar/validar o Refresh Token. DEVE ser diferente de
# JWT_SECRET — se access e refresh token usarem o mesmo segredo, vazar um
# compromete o outro. A funcionalidade de refresh ainda não está implementada
# nesta etapa (só a estrutura), mas o token já é emitido com este segredo.
JWT_REFRESH_SECRET=

# JWT_REFRESH_EXPIRES_IN
# Tempo de validade do Refresh Token. Costuma ser bem mais longo que o access
# token, já que serve para obter novos access tokens sem novo login.
# Sugestão:
JWT_REFRESH_EXPIRES_IN=7d

# --- Login com Google (OAuth 2.0) --------------------------------------------

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Credenciais do OAuth Client criado no Google Cloud Console (APIs & Services
# > Credentials > Create Credentials > OAuth client ID > tipo "Web
# application"). Usadas pelo passport-google-oauth20 para autenticar a
# aplicação junto ao Google e trocar o "code" do login pelo perfil do
# usuário. GOOGLE_CLIENT_SECRET é tão sensível quanto uma senha — nunca deve
# vazar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GOOGLE_CALLBACK_URL
# URL completa (deste backend) para onde o Google redireciona o navegador
# após o usuário aprovar o login — precisa estar cadastrada exatamente igual
# em "Authorized redirect URIs" no mesmo OAuth Client do Google Cloud
# Console, senão o Google recusa o redirect.
# Sugestão para desenvolvimento local (ajuste a porta conforme PORT):
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Busca de questões na web (Google Programmable Search) --------------------
# Opcional: sem estas duas chaves, a busca de questões na web (item 10) entra
# em MODO DEMONSTRAÇÃO — vasculha o próprio banco da Lumina em vez da internet,
# e o response sinaliza provider="demo" com demoMode=true.
#
# Com as duas chaves presentes, o backend usa o Google CSE automaticamente
# (nenhuma mudança de código é necessária) e passa a devolver
# provider="google-cse" com demoMode=false. Basta reiniciar o backend.
#
# GOOGLE_CSE_ID: o Search engine ID (o "cx") do seu Programmable Search
#   Engine em https://programmablesearchengine.google.com/
# GOOGLE_CSE_API_KEY: a API key do Google Cloud com a Custom Search JSON API
#   habilitada.
#
# Detalhes e política de direitos autorais em docs/BUSCA_WEB.md.
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# --- E-mail transacional (Resend) ------------------------------------------
# Opcional: sem RESEND_API_KEY, o MailerService simula o envio no no console
# (útil em dev), em vez de quebrar o boot da aplicação.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lumina <onboarding@resend.dev>

# --- LuminIA (IA) ------------------------------------------------------------

# AI_PROVIDER
# Provedor da LuminIA: "mock" (resposta simulada, sem API externa — padrão
# seguro), "openrouter" (agregador com modelos gratuitos), "openai",
# "anthropic", "groq" ou "gemini".
AI_PROVIDER=mock

# OPENAI_API_KEY / OPENAI_BASE_URL
# Chave do provedor compatível com a API da OpenAI (OpenAI ou OpenRouter —
# no OpenRouter a chave começa com sk-or-v1-). Deixe vazio com AI_PROVIDER=mock.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AI_MODEL / AI_FALLBACK_MODELS
# Modelo principal e, separados por vírgula, os que são tentados em seguida
# quando o principal falha ou não responde a tempo.
AI_MODEL=
AI_FALLBACK_MODELS=

# Prefixo de provedor (AI_ESSAY_MODELS e AI_VISION_MODELS)
# Cada modelo pode levar o provedor na frente: "gemini:", "groq:",
# "openrouter:" ou "openai:". Assim uma mesma lista mistura provedores e cai
# para o próximo quando um esgota a cota. Sem prefixo, vale o AI_PROVIDER.
# Provedor sem chave configurada é pulado.

# AI_ESSAY_MODELS (opcional)
# Modelos da correção de redação, em ordem de tentativa, separados por
# vírgula. A correção pede texto longo e estruturado (JSON das cinco
# competências) e se beneficia de um modelo maior que o do chat. Vazio = usa
# AI_MODEL + AI_FALLBACK_MODELS. A calibração em
# src/essay-correction/model/llm-calibration.json foi ajustada com o modelo
# indicado lá; trocar de modelo pede rodar `npm run essay:eval` de novo.
# A calibração é por modelo e por competência (byModel): cada modelo usa as
# próprias funções, ajustadas com `npm run essay:eval -- --models <modelo>`.
# Ex.: gemini:gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,gemini:gemini-3.5-flash
AI_ESSAY_MODELS=

# AI_ANSWER_KEY_MODELS (opcional)
# Cadeia própria do Gabarito Inteligente (gabarito sugerido por IA e
# explicação por questão), no mesmo formato de AI_ESSAY_MODELS. Sem valor,
# usa AI_ESSAY_MODELS. Motivo: na medição de 12/11/2026 o modelo padrão do
# chat acertou 57% das sugestões e forçava alternativas em contas que não
# fecham. Meça antes de trocar: npm run build && npm run answer-keys:eval -- --exam enem --year 2024 --day 2
# Ex.: gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash
AI_ANSWER_KEY_MODELS=

# AI_VISION_MODELS (opcional)
# Modelos com entrada de imagem que leem a foto da redação (scanner). Vazio
# no OpenRouter = google/gemma-4-31b-it:free, nvidia/nemotron-3.5-super-vl:free
# e google/gemma-4-26b-a4b-it:free. Com AI_PROVIDER=openai, o primeiro da
# lista (padrão gpt-4o-mini). Sem provedor com visão, o scanner não lê a foto
# e o aluno digita o texto.
# Ex.: gemini:gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3.5-super-vl:free
AI_VISION_MODELS=

# ESSAY_CORRECTION_MONTHLY_LIMIT
# Correções de redação por IA que cada aluno pode pedir por mês (o mês vira
# à meia-noite de Brasília do dia 1º). Correção que falha, ou cuja nota sai
# sem a IA, devolve o crédito. A leitura de foto só é aceita com crédito
# sobrando, e no máximo 3 fotos lidas por correção do mês. Padrão: 4.
ESSAY_CORRECTION_MONTHLY_LIMIT=4

# ESSAY_COMPETENCY_CONCURRENCY
# A correção avalia cada competência numa chamada separada (5 por avaliador,
# 10 a 15 por redação). Este é o número de chamadas simultâneas. Padrão: 3.
ESSAY_COMPETENCY_CONCURRENCY=3

# AI_RPM_LIMITS / AI_RATE_MAX_WAIT_MS
# Requisições por minuto por modelo, para não estourar o limite do plano:
# "gemini:gemini-3.5-flash-lite=15,groq=8" (o provedor sozinho vale para
# todos os modelos dele). Sem a variável: 15 no Gemini, sem limite nos demais.
# Acima do limite, a chamada espera a vaga até AI_RATE_MAX_WAIT_MS (padrão
# 61000, o que garante a vaga); com valor menor, passa ao próximo modelo.
AI_RPM_LIMITS=
AI_RATE_MAX_WAIT_MS=

# AI_TIMEOUT_MS
# Tempo máximo de espera por CADA chamada ao provedor, em milissegundos.
# Passado esse tempo a vez vai para o próximo modelo; sem nenhum, a LuminIA
# responde com erro em vez de deixar a conversa pendurada.
AI_TIMEOUT_MS=20000

# ANTHROPIC_API_KEY / ANTHROPIC_MODEL (se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# GROQ_API_KEY / GROQ_MODEL
# Chave do Groq (console.groq.com). GROQ_MODEL aceita lista separada por
# vírgula (usada com AI_PROVIDER=groq). Também serve aos modelos "groq:" das
# listas acima. Atenção: o plano gratuito limita ~8 mil tokens por minuto
# CONTANDO o max_tokens pedido — cerca de uma correção de redação a cada 2 min.
GROQ_API_KEY=
GROQ_MODEL=

# GEMINI_API_KEY / GEMINI_MODEL / GEMINI_REASONING_EFFORT
# Chave da Google AI Studio (aistudio.google.com). GEMINI_MODEL aceita lista
# separada por vírgula (usada com AI_PROVIDER=gemini) e a chave também serve
# aos modelos "gemini:" das listas acima. GEMINI_REASONING_EFFORT: quanto o
# modelo "pensa" antes de responder (minimal, low, medium, high; padrão low —
# acima disso os modelos 3.7/3.8 passam de 1 minuto por redação). Atenção:
# no plano gratuito alguns modelos (ex.: gemini-3.5-flash) aceitam só 20
# requisições por dia.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REASONING_EFFORT=low

# --- Planos e cobrança (Asaas) ------------------------------------------------
# Sem ASAAS_API_KEY ou sem PLAN_PREMIUM_MONTHLY_PRICE o app funciona normalmente
# e a assinatura aparece como "em breve" na página "Meu plano".
#
# ASAAS_API_KEY
# Chave da API do Asaas (Minha conta > Integrações). Chaves de sandbox começam
# com $aact_hmlg_ e as de produção com $aact_prod_.
ASAAS_API_KEY=
# ASAAS_ENVIRONMENT
# sandbox (padrão) ou production. Precisa combinar com a chave.
ASAAS_ENVIRONMENT=sandbox
# ASAAS_WEBHOOK_TOKEN
# Token que você define ao cadastrar o webhook no Asaas (URL:
# https://SEU_BACKEND/billing/webhooks/asaas). O Asaas o envia no header
# asaas-access-token. Gere um valor aleatório longo; NUNCA use a chave da API.
ASAAS_WEBHOOK_TOKEN=
# PLAN_PREMIUM_YEARLY_PRICE
# Preço total do plano anual em reais, ex.: 299.00. É a oferta principal:
# cobrado no cartão em até PLAN_YEARLY_MAX_INSTALLMENTS parcelas (padrão 12),
# sem renovação automática. Sem valor, o app oferece só o mensal.
PLAN_PREMIUM_YEARLY_PRICE=
# PLAN_YEARLY_MAX_INSTALLMENTS=12
#
# PLAN_PREMIUM_MONTHLY_PRICE
# Preço mensal do Premium em reais, ex.: 29.90 (assinatura recorrente).
PLAN_PREMIUM_MONTHLY_PRICE=
#
# Benefício de fundador: Premium sem cobrança para os primeiros alunos
# independentes, por tempo limitado. Padrões: 100 vagas, 4 meses de benefício,
# campanha de 11/11/2026 a 11/05/2027.
# FOUNDER_STUDENT_SLOTS=100
# FOUNDER_GRANT_MONTHS=4
# FOUNDER_CAMPAIGN_STARTS_AT=2026-11-11T03:00:00.000Z
# FOUNDER_CAMPAIGN_ENDS_AT=2027-05-11T03:00:00.000Z

# --- Videoaulas da LuminIA (YouTube) ------------------------------------------
# YOUTUBE_API_KEY
# Chave da YouTube Data API v3 (Google Cloud > APIs e serviços > ativar
# "YouTube Data API v3" > Credenciais). Pode ser a mesma chave do projeto da
# busca na web (GOOGLE_CSE_API_KEY) se a API do YouTube estiver ativada nele.
# Cota gratuita: 10.000 unidades/dia; cada busca gasta 100, e o resultado fica
# em cache por 24 h. Sem chave, o app mostra o link da busca no YouTube.
YOUTUBE_API_KEY=
