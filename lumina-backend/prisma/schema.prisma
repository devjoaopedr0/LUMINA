generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Autenticação do usuário. Não contém dados públicos de perfil — ver
/// UserProfile, separada para manter esta tabela enxuta e não expor
/// password_hash junto de dados exibíveis publicamente.
model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  email                  String                      @unique
  passwordHash           String?                     @map("password_hash")
  emailVerified          Boolean                     @default(false) @map("email_verified")
  status                 UserStatus                  @default(ACTIVE)
  accountType            AccountType                 @default(STUDENT_INDEPENDENT) @map("account_type")
  lastLogin              DateTime?                   @map("last_login")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  deletedAt              DateTime?                   @map("deleted_at")
  googleId               String?                     @unique @map("google_id")
  sessionVersion         Int                         @default(0) @map("session_version")
  authSessions           AuthSession[]
  classMemberships       ClassMember[]
  classesTeaching        ClassTeacher[]
  coordinatedClasses     Class[]                     @relation("ClassCoordinator")
  createdClasses         Class[]                     @relation("ClassCreatedBy")
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
  questionAttempts       QuestionAttempt[]
  createdQuestions       Question[]                  @relation("QuestionCreatedBy")
  profile                UserProfile?
  questionProgress       UserQuestionProgress[]
  errorNotebook          ErrorNotebookEntry[]
  workspaceMembers       WorkspaceMember[]
  studySchedule          StudySchedule?
  studyTimeLogs          StudyTimeLog[]
  topicMasteries         TopicMastery[]
  topicMasteryHistory    TopicMasteryHistory[]
  selectedVestibular     UserVestibular?
  mentalMathSessions     MentalMathSession[]
  essays                 Essay[]
  essayScans             EssayScan[]
  essayCorrectionUsages  EssayCorrectionUsage[]
  subscriptions          Subscription[]
  planUsages             PlanUsage[]
  notebookCollections    NotebookCollection[]
  essayReviews           EssayReview[]               @relation("EssayReviewEvaluator")
  essayReviewsValidated  EssayReview[]               @relation("EssayReviewValidator")
  essayReviewMessages    EssayReviewMessage[]        @relation("EssayReviewMessageAuthor")
  essayLearningCreated   EssayLearningRecord[]       @relation("EssayLearningCreatedBy")
  essayLearningValidated EssayLearningRecord[]       @relation("EssayLearningValidatedBy")
  essayAuditEvents       EssayAuditEvent[]
  teacherProfile         TeacherProfile?
  authoredEssayThemes    EssayTheme[]
  createdSimulations     Simulation[]
  simulationSubmissions  SimulationSubmission[]
  adaptiveSessions       AdaptiveSimulationSession[]
  adaptiveSteps          AdaptiveSimulationStep[]
  answerSheetUploads     AnswerSheetUpload[]
  answerSheetSubmissions AnswerSheetSubmission[]
  answerSheetReviews     AnswerSheetSubmission[]     @relation("AnswerSheetReview")
  answerSheetScans       AnswerSheetUpload[]         @relation("AnswerSheetScanner")
  answerSheetCodes       AnswerSheetCode[]
  answerSheetBatches     AnswerSheetBatch[]
  answerKeysCreated      AnswerKey[]                 @relation("AnswerKeyCreatedBy")
  answerKeyChecks        AnswerKeyCheck[]
  answerKeyVotes         AnswerKeyVote[]
  questionScanUploads    QuestionScanUpload[]
  questionScanResults    QuestionScanResult[]
  essayFeedbacks         EssayFeedback[]             @relation("EssayFeedbackAuthor")
  formulas               Formula[]
  repertoires            Repertoire[]
  studyGroupsOwned       StudyGroup[]                @relation("StudyGroupOwner")
  studyGroupMemberships  StudyGroupMember[]
  flashcards             Flashcard[]
  flashcardReviews       FlashcardReview[]

  @@map("users")
  pedagogicalAlerts        PedagogicalAlert[]        @relation("PedagogicalAlertTeacher")
  recoveryPlans            RecoveryPlan[]            @relation("RecoveryPlanStudent")
  recoveryPlansCreated     RecoveryPlan[]            @relation("RecoveryPlanCreatedBy")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model MentalMathSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mode      String
  dailyKey  String?  @map("daily_key")
  state     Json
  version   Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyKey])
  @@index([userId, createdAt])
  @@map("mental_math_sessions")
}

model Essay {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  title            String                 @default("") @db.VarChar(160)
  theme            String                 @default("") @db.VarChar(300)
  content          String                 @default("")
  version          Int                    @default(0)
  wordCount        Int                    @default(0) @map("word_count")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions        EssayRevision[]
  correction       EssayCorrection?
  versions         EssayVersion[]
  feedbacks        EssayFeedback[]
  scans            EssayScan[]
  correctionUsages EssayCorrectionUsage[]
  reviews          EssayReview[]
  reviewMessages   EssayReviewMessage[]
  learningRecords  EssayLearningRecord[]

  @@index([userId, updatedAt])
  @@map("essays")
}

model EssayRevision {
  id        String   @id @default(uuid()) @db.Uuid
  essayId   String   @map("essay_id") @db.Uuid
  version   Int
  title     String   @db.VarChar(160)
  theme     String   @db.VarChar(300)
  content   String
  wordCount Int      @map("word_count")
  createdAt DateTime @default(now()) @map("created_at")
  essay     Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)

  @@unique([essayId, version])
  @@map("essay_revisions")
}

model TeacherProfile {
  userId    String   @id @map("user_id") @db.Uuid
  subject   String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model EssayTheme {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(300)
  exam      String   @db.VarChar(60)
  year      Int?
  sourceUrl String?  @map("source_url") @db.VarChar(2048)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([exam, year])
  @@map("essay_themes")
}

/// Redação nota 1000 oficial (ENEM ou vestibular), curada como referência de
/// estudo — item 23. Conteúdo público já divulgado pela banca/imprensa, não
/// a redação de nenhum aluno da plataforma: sem o problema de privacidade
/// que teria reaproveitar Essay (redação privada de outro usuário) para
/// compor esta biblioteca.
model EssayModel {
  id               String   @id @default(uuid()) @db.Uuid
  year             Int
  exam             String   @db.VarChar(60)
  theme            String   @db.VarChar(300)
  text             String
  /**
   * Nota por competência: { C1: 200, C2: 200, C3: 200, C4: 200, C5: 200 }.
   */
  competenciesJson Json     @map("competencies_json")
  /**
   * Nota total (soma das competências, máx 1000).
   */
  totalScore       Int      @map("total_score")
  /**
   * PDF oficial da redação, quando disponível para download.
   */
  pdfUrl           String?  @map("pdf_url") @db.VarChar(2048)
  /**
   * Trechos em destaque por competência: { C1: "...", C2: "...", ... }.
   */
  highlightsJson   Json?    @map("highlights_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([exam, year])
  @@map("essay_models")
}

/// Item 21 do inventário: caderno de fórmulas. Uma fórmula por linha, do
/// aluno, com a expressão em LaTeX, a disciplina, o assunto em que ela é
/// usada e uma anotação pessoal ("quando usar", variações). O favoritos
/// serve para fixar as fórmulas que o aluno ainda não memorizou.
model Formula {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Nome curto da fórmula (ex.: "Bhaskara", "Área do círculo").
  name        String   @db.VarChar(160)
  /// Disciplina: MATEMATICA, FISICA, QUIMICA, BIOLOGIA, OUTRA.
  discipline  String   @default("MATEMATICA") @db.VarChar(40)
  /// Assunto dentro da disciplina (ex.: "Funções quadráticas").
  topic       String?  @db.VarChar(160)
  /// A expressão em LaTeX, ex.: x = (-b ± √(b²-4ac)) / 2a.
  latex       String
  /// Anotações pessoais: quando usar, variações, macetes.
  description String?
  /// O que cada símbolo significa (ex.: "a, b, c: coeficientes").
  variables   String?
  /// Em que tipo de questão a fórmula aparece.
  whenToUse   String?  @map("when_to_use")
  /// Exemplo resolvido curto.
  example     String?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  /// Marcado pelo aluno quando já sabe a fórmula de cor.
  isMemorized Boolean  @default(false) @map("is_memorized")
  /// MANUAL, AI ou PLATFORM_COPY (copiada do acervo da plataforma).
  origin      String   @default("MANUAL") @db.VarChar(20)
  /// Item do acervo da plataforma (curado pela administração, só leitura para os alunos).
  isPlatform  Boolean  @default(false) @map("is_platform")
  /// De qual item da plataforma esta cópia veio.
  platformSourceId String? @map("platform_source_id") @db.Uuid
  collectionItems FormulaCollectionItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, discipline])
  @@index([userId, isFavorite])
  @@index([isPlatform])
  @@map("formulas")
}

/// Item 22 do inventário: caderno de repertórios socioculturais. Serve à
/// redação do ENEM: o aluno guarda um repertório (livro, filme, lei,
/// pesquisa) e o reutiliza como argumento. Cada registro guarda a fonte e
/// o ano para citar com precisão na redação e o tema para filtrar na escrita.
/// para citar com precisão na redação e o tema para filtrar na escrita.
model Repertoire {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Título do repertório (ex.: "George Orwell — 1984").
  title     String   @db.VarChar(240)
  /// Resumo com as ideias principais, dados e argumentos.
  summary   String
  /// Fonte (livro, artigo, filme, série, lei, dados de pesquisa).
  source    String?  @db.VarChar(160)
  year      Int?
  /// Tema para filtro: TECNOLOGIA, MEIO_AMBIENTE, SAUDE, POLITICA,
  /// EDUCACAO, ECONOMIA, CULTURA, CIENCIA, DIREITOS_HUMANOS, OUTRO.
  theme     String   @default("OUTRO") @db.VarChar(40)
  /// Palavras-chave para localizar o repertório na hora da redação.
  keywords  String[] @default([])
  /// Marcado pelo aluno quando já domina o repertório.
  isStudied Boolean  @default(false) @map("is_studied")
  /// Categoria do caderno (FILOSOFIA, SOCIOLOGIA, ...) ou nome de uma
  /// categoria criada pelo aluno.
  category      String   @default("OUTRA") @db.VarChar(60)
  /// Autor ou responsável (pensador, cineasta, órgão que publicou os dados).
  author        String?  @db.VarChar(200)
  /// LIVRO, FILME, SERIE, MUSICA, LEI, PESQUISA, PENSADOR, OBRA_DE_ARTE,
  /// ACONTECIMENTO, CONCEITO, OUTRO.
  referenceType String   @default("OUTRO") @map("reference_type") @db.VarChar(40)
  /// Contexto histórico, social ou cultural.
  context       String?
  /// Importância sociocultural.
  importance    String?
  /// Como aplicar na redação.
  essayUse      String?  @map("essay_use")
  /// Exemplo de uso argumentativo (um trecho pronto para adaptar).
  example       String?
  /// Temas de redação com que o repertório se relaciona (texto livre).
  relatedThemes String[] @default([]) @map("related_themes")
  /// Anotações pessoais.
  notes         String?
  isFavorite    Boolean  @default(false) @map("is_favorite")
  /// MANUAL, AI (sugestão da LuminIA revisada pelo aluno) ou PLATFORM_COPY.
  origin        String   @default("MANUAL") @db.VarChar(20)
  isPlatform    Boolean  @default(false) @map("is_platform")
  platformSourceId String? @map("platform_source_id") @db.Uuid
  /// Eixos temáticos (especificação de 13/11/2026), um repertório pode ter vários.
  axes              String[] @default([])
  /// Funções no mapa de aplicação argumentativa (explicar desigualdades
  /// estruturais, evidenciar omissão estatal...).
  argumentFunctions String[] @default([]) @map("argument_functions")
  /// Conceitos fundamentais.
  concepts          String[] @default([])
  /// Problemas sociais que o repertório ajuda a explicar.
  socialProblems    String?  @map("social_problems")
  /// Relação com a realidade brasileira.
  brazilRelation    String?  @map("brazil_relation")
  /// Em que desenvolvimento o exemplo se encaixa: D1 ou D2.
  exampleSlot       String?  @map("example_slot") @db.VarChar(4)
  /// Possíveis conexões com outros repertórios.
  connections       String?
  /// Cuidados para evitar uso superficial ou decorativo.
  pitfalls          String?
  /// Citação literal (separada da paráfrase), sempre com a fonte exata.
  quote             String?
  quoteSource       String?  @map("quote_source") @db.VarChar(300)
  collectionItems RepertoireCollectionItem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, theme])
  @@index([userId, isStudied])
  @@index([userId, category])
  @@index([userId, isFavorite])
  @@index([isPlatform])
  @@map("repertoires")
}

/// Token de redefinição de senha (fluxo "esqueci minha senha"). Guardamos
/// apenas o SHA-256 do token — o valor cru só existe no e-mail enviado ao
/// usuário — e invalidamos por expiração (expires_at) e uso único (used_at).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Código numérico de verificação de e-mail (fluxo de cadastro). Assim como
/// o reset de senha, guardamos apenas o SHA-256 do código — o valor cru só
/// é enviado por e-mail. Uso único (used_at) e expiração curta (expires_at).
model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

/// Dados públicos/exibíveis do usuário (1:1 com User). first_name é
/// obrigatório (necessário desde o primeiro acesso, ex: saudação no
/// dashboard); os demais campos ficam disponíveis para preenchimento
/// progressivo do perfil e por isso são opcionais.
model UserProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  firstName            String    @map("first_name")
  lastName             String?   @map("last_name")
  username             String?   @unique
  avatarUrl            String?   @map("avatar_url")
  phone                String?
  birthDate            DateTime? @map("birth_date") @db.Date
  bio                  String?
  educationLevel       String?   @map("education_level") @db.VarChar(30)
  schoolYear           Int?      @map("school_year")
  schoolName           String?   @map("school_name") @db.VarChar(120)
  desiredCourse        String?   @map("desired_course") @db.VarChar(120)
  targetUniversity     String?   @map("target_university") @db.VarChar(120)
  /// Modalidade de concorrência do aluno no Sisu (AC, LB_PPI, LI_EP...) —
  /// escolhe qual nota de corte vira a meta dele. Nulo = ampla concorrência.
  sisuModality         String?   @map("sisu_modality") @db.VarChar(10)
  preferredStudyPeriod String?   @map("preferred_study_period") @db.VarChar(20)
  studySessionMinutes  Int?      @map("study_session_minutes")
  weeklyStudyDays      Int?      @map("weekly_study_days")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Nota de corte do Sisu de um curso ofertado (curso + campus + turno) numa
/// edição, a partir dos relatórios "Inscrições e notas de corte" que o MEC
/// publica. Uma linha por curso e ano, com a nota de cada modalidade em
/// coluna: ampla concorrência e as oito da Lei de Cotas (LB = até o limite
/// de renda, LI = independente de renda; PPI, quilombolas, PCD e demais
/// egressos de escola pública). Nula onde o curso não teve aquela vaga.
model SisuCutoff {
  id                 String @id @default(uuid()) @db.Uuid
  year               Int
  /// CO_IES_CURSO do e-MEC: o mesmo curso/campus/turno ao longo dos anos.
  courseCode         Int    @map("course_code")
  institutionCode    Int    @map("institution_code")
  institutionName    String @map("institution_name")
  institutionAcronym String @map("institution_acronym")
  campus             String
  city               String
  state              String @db.Char(2)
  courseName         String @map("course_name")
  degree             String
  shift              String
  /// Nome do curso e sigla/nome da instituição sem acento e em maiúsculas,
  /// para casar com o texto livre do cadastro ("medicina", "ufc").
  courseKey          String @map("course_key")
  institutionKey     String @map("institution_key")
  scoreAc            Float? @map("score_ac")
  scoreLbPpi         Float? @map("score_lb_ppi")
  scoreLbQ           Float? @map("score_lb_q")
  scoreLbPcd         Float? @map("score_lb_pcd")
  scoreLbEp          Float? @map("score_lb_ep")
  scoreLiPpi         Float? @map("score_li_ppi")
  scoreLiQ           Float? @map("score_li_q")
  scoreLiPcd         Float? @map("score_li_pcd")
  scoreLiEp          Float? @map("score_li_ep")

  @@unique([year, courseCode])
  @@index([courseKey])
  @@map("sisu_cutoffs")
}

/// Organização que licencia a Lumina (escola, cursinho, professor
/// particular, grupo de estudos). Possui exatamente um Workspace do tipo
/// INSTITUTION — ver Workspace.institutionId.
model Institution {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  cnpj          String?           @unique
  email         String            @unique
  phone         String?
  logoUrl       String?           @map("logo_url")
  status        InstitutionStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  workspace     Workspace?
  subscriptions Subscription[]

  @@map("institutions")
}

/// Ambiente de trabalho dentro da plataforma. Todo usuário possui
/// automaticamente um Workspace PERSONAL (institutionId nulo); toda
/// Institution possui exatamente um Workspace INSTITUTION. A constraint
/// UNIQUE em institutionId é o que garante esse 1:1 no banco.
model Workspace {
  id               String            @id @default(uuid()) @db.Uuid
  institutionId    String?           @unique @map("institution_id") @db.Uuid
  name             String
  type             WorkspaceType
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  classes          Class[]
  simulations      Simulation[]
  questionAttempts QuestionAttempt[]
  questions        Question[]
  roles            Role[]
  members          WorkspaceMember[]
  institution      Institution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriods  AcademicPeriod[]

  @@map("workspaces")
}

/// Vincula usuários a Workspaces com um cargo (Role) e status de vínculo.
/// Diferente de ClassMember/ClassTeacher, tem updated_at porque `status` é
/// mutável (ex: INVITED -> ACTIVE, ACTIVE -> SUSPENDED).
model AcademicPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(120)
  startsAt    DateTime  @map("starts_at") @db.Date
  endsAt      DateTime  @map("ends_at") @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classes     Class[]

  @@unique([workspaceId, name])
  @@index([workspaceId, startsAt])
  @@map("academic_periods")
}

model WorkspaceMember {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  roleId      String                @map("role_id") @db.Uuid
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now()) @map("joined_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  role        Role                  @relation(fields: [roleId], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// Cargo dentro de um Workspace (ex: Administrador, Professor, Aluno).
/// is_system marca cargos padrão criados automaticamente para todo novo
/// Workspace — protegidos contra edição/exclusão pela aplicação.
model Role {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  name             String
  description      String?
  isSystem         Boolean           @default(false) @map("is_system")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  rolePermissions  RolePermission[]
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceMembers WorkspaceMember[]

  @@index([workspaceId])
  @@map("roles")
}

/// Catálogo global de permissões do sistema (ex: CREATE_CLASS). Não
/// pertence a um Workspace — é compartilhado; Roles se vinculam a ela via
/// RolePermission.
model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Concede uma Permission a uma Role. Tabela de junção pura — sem
/// updated_at porque conceder/revogar é criar/deletar linha, não atualizar.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Turma dentro de um Workspace institucional. Ingresso de alunos via
/// join_code (estilo Google Classroom).
///
/// Regra de negócio que o Postgres não expressa via FK: workspaceId deve
/// referenciar um Workspace com type = INSTITUTION. Precisa ser validada na
/// camada de aplicação (ou via trigger) antes de criar/mover uma turma.
model Class {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  name             String
  description      String?
  joinCode         String          @unique @map("join_code")
  maxStudents      Int?            @map("max_students")
  coordinatorId    String?         @map("coordinator_id") @db.Uuid
  subjectId        String?         @map("subject_id") @db.Uuid
  academicPeriodId String?         @map("academic_period_id") @db.Uuid
  /// Ano/série da turma (ex: 3 = "3º ano") — mesma convenção de
  /// UserProfile.schoolYear. Organização por ano letivo em si já é
  /// coberta por academicPeriodId (Fase 5: períodos letivos).
  gradeYear        Int?            @map("grade_year")
  archived         Boolean         @default(false)
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  members          ClassMember[]
  teachers         ClassTeacher[]
  simulations      Simulation[]
  coordinator      User?           @relation("ClassCoordinator", fields: [coordinatorId], references: [id])
  creator          User            @relation("ClassCreatedBy", fields: [createdBy], references: [id])
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([subjectId])
  @@index([academicPeriodId])
  @@map("classes")
}

/// Vincula alunos a turmas.
model ClassMember {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_members")
}

/// Vincula professores a turmas — N:N: um professor pode lecionar em várias
/// turmas, uma turma pode ter vários professores.
model ClassTeacher {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_teachers")
}

/// Disciplina estruturada do banco de questões. Questões podem referenciar
/// via FK (subjectId) e também mantêm o texto denormalizado (Question.subject)
/// para exibição sem join. subjects é o primeiro nível de classificação
/// (ex: Matemática) — alimenta filtros e as futuras análises da LuminIA.
model Subject {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  questions      Question[]     @relation("QuestionSubject")
  topics         Topic[]        @relation("TopicSubject")
  classes        Class[]
  topicMasteries TopicMastery[]
  flashcards     Flashcard[]

  @@map("subjects")
}

/// Assunto dentro de uma disciplina (ex: "Funções exponenciais" dentro de
/// Matemática). Segundo nível de classificação das questões.
model Topic {
  id             String                @id @default(uuid()) @db.Uuid
  subjectId      String                @map("subject_id") @db.Uuid
  name           String
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  questions      Question[]            @relation("QuestionTopic")
  subject        Subject               @relation("TopicSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  topicMasteries TopicMastery[]
  masteryHistory TopicMasteryHistory[]
  studyTasks     StudyTask[]
  lesson         TopicLesson?
  flashcards     Flashcard[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topics")
}

/// Resumo de teoria do tópico, mostrado na tarefa de "Teoria" do
/// cronograma. Um por tópico e igual para todos os alunos: é gerado na
/// primeira vez que alguém abre e reaproveitado depois.
model TopicLesson {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @unique @map("topic_id") @db.Uuid
  /// Texto em seções ("## Título"), listas ("- ") e **negrito**.
  content   String
  /// De onde veio: "AI" (gerado) ou "MANUAL" (escrito/revisado por alguém).
  source    String   @default("AI") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_lessons")
}

/// Estado de domínio do aluno num tópico — cronograma adaptativo, fase 1
/// (docs/CRONOGRAMA_ADAPTATIVO_DESIGN.md §2). Alimentado a cada tentativa de
/// questão (Question.subjectId/topicId) e a cada simulado respondido. É a
/// peça que falta hoje para o cronograma priorizar por desempenho real em
/// vez de só distribuir horas-alvo proporcionalmente.
model TopicMastery {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  subjectId          String             @map("subject_id") @db.Uuid
  topicId            String             @map("topic_id") @db.Uuid
  /// 0-100, ver fórmula no design doc §3 (peso maior para tentativas
  /// recentes — desempenho antigo não deve segurar a nota para sempre).
  masteryScore       Int                @default(0) @map("mastery_score")
  attempts           Int                @default(0)
  correctAttempts    Int                @default(0) @map("correct_attempts")
  /// Acertos seguidos — mesma lógica do caderno de erros
  /// (ERROR_NOTEBOOK_MASTERED_STREAK), aqui aplicada ao domínio do tópico.
  correctStreak      Int                @default(0) @map("correct_streak")
  status             TopicMasteryStatus @default(NAO_ESTUDADO)
  lastStudiedAt      DateTime?          @map("last_studied_at")
  /// Próxima revisão espaçada — mesma semântica de
  /// ErrorNotebookEntry.reviewScheduledAt (comparação por dia, meia-noite UTC).
  nextReviewAt       DateTime?          @map("next_review_at")
  reviewIntervalDays Int                @default(1) @map("review_interval_days")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@map("topic_masteries")
}

/// Histórico do domínio por tópico: uma linha por aluno, tópico e DIA (em
/// horário de Brasília) em que o domínio mudou, com o valor ao fim do dia.
/// TopicMastery guarda só o estado atual; é daqui que sai "quanto subiu na
/// semana" no resumo semanal.
model TopicMasteryHistory {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  topicId         String             @map("topic_id") @db.Uuid
  day             DateTime           @db.Date
  masteryScore    Int                @map("mastery_score")
  status          TopicMasteryStatus
  attempts        Int                @default(0)
  correctAttempts Int                @default(0) @map("correct_attempts")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, day])
  @@index([userId, day])
  @@map("topic_mastery_history")
}

enum TopicMasteryStatus {
  NAO_ESTUDADO
  APRENDENDO
  PRATICANDO
  DOMINADO
  PRECISA_REFORCO
}

/// Prova/concurso estruturado (ex: ENEM 2023). Questões podem ou não vir de
/// uma prova; questões autorais costumam ter examId nulo.
model Exam {
  id               String                      @id @default(uuid()) @db.Uuid
  name             String
  year             Int?
  institution      String?
  description      String?
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  questions        Question[]                  @relation("QuestionExam")
  userVestibulares UserVestibular[]
  adaptiveSessions AdaptiveSimulationSession[]
  papers           ExamPaper[]
  answerKeys       AnswerKey[]

  @@index([name, year])
  @@map("exams")
}

/// Questão de múltipla escolha do banco de questões do Lumina, sempre
/// vinculada a um Workspace. A origem é rastreada (sourceType/sourceName/
/// sourceId) e o conteúdo normalizado tem um hash (contentHash) usado na
/// deduplicação de importações. subject/topic/exam guardam o texto exibível
/// (denormalizado, compatível com o fluxo atual); subjectId/topicId/examId
/// são FKs opcionais para classificação estruturada (filtros precisos).
/// `metadata` (JSON) reserva espaço para futura geração por IA (modelo,
/// versão de prompt, confiança) e embeddings (pgvector) sem remodelar o banco.
model Question {
  id                 String                   @id @default(uuid()) @db.Uuid
  workspaceId        String                   @map("workspace_id") @db.Uuid
  subject            String
  topic              String
  difficulty         QuestionDifficulty
  exam               String
  year               Int?
  examNumber         Int?                     @map("exam_number")
  stem               String
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  contentHash        String?                  @map("content_hash")
  createdBy          String?                  @map("created_by") @db.Uuid
  examId             String?                  @map("exam_id") @db.Uuid
  explanation        String?
  imageUrl           String?                  @map("image_url")
  metadata           Json?
  sourceId           String?                  @map("source_id")
  sourceName         String                   @default("Lumina") @map("source_name")
  sourceType         QuestionSourceType       @default(OFFICIAL) @map("source_type")
  subjectId          String?                  @map("subject_id") @db.Uuid
  topicId            String?                  @map("topic_id") @db.Uuid
  /// Habilidade da Matriz de Referência do ENEM (ex.: "MT-H17"). Nula = ainda
  /// não classificada. Ver src/questions/enem-skills.
  enemSkill          String?                  @map("enem_skill") @db.VarChar(6)
  /// Quem classificou: AI (sugestão, pendente) ou MANUAL (professor/gestão).
  enemSkillOrigin    String?                  @map("enem_skill_origin") @db.VarChar(10)
  enemSkillValidated Boolean                  @default(false) @map("enem_skill_validated")
  /// Justificativa curta da classificação automática.
  enemSkillNote      String?                  @map("enem_skill_note")
  alternatives       QuestionAlternative[]
  simulationItems    SimulationItem[]
  attempts           QuestionAttempt[]
  creator            User?                    @relation("QuestionCreatedBy", fields: [createdBy], references: [id])
  examRef            Exam?                    @relation("QuestionExam", fields: [examId], references: [id])
  subjectRef         Subject?                 @relation("QuestionSubject", fields: [subjectId], references: [id])
  topicRef           Topic?                   @relation("QuestionTopic", fields: [topicId], references: [id])
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progress           UserQuestionProgress[]
  errorNotebook      ErrorNotebookEntry[]
  adaptiveSteps      AdaptiveSimulationStep[]
  scanResults        QuestionScanResult[]
  examPaperQuestions ExamPaperQuestion[]
  answerKeyItems     AnswerKeyItem[]
  flashcards         Flashcard[]

  @@index([workspaceId])
  @@index([workspaceId, subject])
  @@index([workspaceId, difficulty])
  @@index([workspaceId, exam])
  @@index([workspaceId, subjectId])
  @@index([workspaceId, topicId])
  @@index([workspaceId, enemSkill])
  @@index([workspaceId, examId])
  @@index([sourceType])
  @@index([contentHash])
  @@map("questions")
}

/// Alternativa de múltipla escolha. `position` é a ordem na prova (1, 2, 3,
/// 4, 5) exibida como A, B, C, D, E no frontend. Apenas uma alternativa por
/// questão deve ter is_correct = true (regra validada no service).
model QuestionAlternative {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  text        String
  position    Int
  isCorrect   Boolean  @default(false) @map("is_correct")
  /// Por que esta alternativa está errada. Texto do autor da questão, exibido
  /// ao aluno **só depois** que ele responde (no resultado da tentativa) — antes
  /// disso revelaria o gabarito. Nulo quando a questão não detalha o distrator.
  explanation String?
  createdAt   DateTime @default(now()) @map("created_at")
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_alternatives")
}

model Simulation {
  id                     String                  @id @default(uuid()) @db.Uuid
  title                  String                  @db.VarChar(160)
  createdBy              String                  @map("created_by") @db.Uuid
  classId                String?                 @map("class_id") @db.Uuid
  workspaceId            String                  @map("workspace_id") @db.Uuid
  assessmentType         AssessmentType          @default(SIMULATION) @map("assessment_type")
  dueAt                  DateTime?               @map("due_at")
  /**
   * Duração do simulado em minutos (opcional). Quando definido, o cronômetro
   * roda na resolução e o envio automático ocorre no fim do tempo.
   */
  durationMinutes        Int?                    @map("duration_minutes")
  /**
   * Modo "prova real": cronômetro obrigatório, sem dicas, resultado só ao final.
   */
  isRealExam             Boolean                 @default(false) @map("is_real_exam")
  /// Simulado modelo ENEM: 1 ou 2 = o dia de prova que ele reproduz (90
  /// questões, 45 por área). Nulo nos simulados comuns.
  enemDay                Int?                    @map("enem_day")
  createdAt              DateTime                @default(now()) @map("created_at")
  creator                User                    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  class                  Class?                  @relation(fields: [classId], references: [id], onDelete: SetNull)
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items                  SimulationItem[]
  /// Tarefas do cronograma que este simulado conclui ao ser enviado.
  studyTasks             StudyTask[]
  submissions            SimulationSubmission[]
  answerSheetUploads     AnswerSheetUpload[]
  answerSheetSubmissions AnswerSheetSubmission[]
  /**
   * Cartão-resposta gerado automaticamente na criação (opcional, só para
   * professor/coordenador/diretor) — ver AnswerSheetTemplate.simulationId.
   */
  answerSheetTemplate    AnswerSheetTemplate?

  @@index([createdBy, createdAt])
  @@index([classId])
  @@index([classId, dueAt])
  @@map("simulations")
}

model SimulationSubmission {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @map("simulation_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  answers      Json
  /**
   * Quando o aluno iniciou a resolução (para cronômetro e modo prova real).
   */
  startedAt    DateTime?  @default(now()) @map("started_at")
  correct      Int
  total        Int
  submittedAt  DateTime   @default(now()) @map("submitted_at")
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([simulationId, userId])
  @@index([userId, submittedAt])
  @@map("simulation_submissions")
}

model SimulationItem {
  id              String     @id @default(uuid()) @db.Uuid
  simulationId    String     @map("simulation_id") @db.Uuid
  questionId      String?    @map("question_id") @db.Uuid
  position        Int
  stem            String
  alternatives    Json
  correctPosition Int        @map("correct_position")
  subject         String
  /**
   * Área do conhecimento (ex.: "Matemática e suas Tecnologias", "Ciências da Natureza") — usado no modo prova real estilo ENEM.
   */
  area            String?    @db.VarChar(80)
  simulation      Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  question        Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([simulationId, position])
  @@map("simulation_items")
}

/// Registro de uma resposta dada a uma questão. Guarda a posição escolhida
/// (não um FK para a alternativa, para que o histórico sobreviva a edições
/// da questão) e o acerto/erro calculado no momento da resposta — imutável
/// por ser histórico, usado depois em estatísticas de desempenho.
model QuestionAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  questionId       String    @map("question_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  selectedPosition Int       @map("selected_position")
  isCorrect        Boolean   @map("is_correct")
  createdAt        DateTime  @default(now()) @map("created_at")
  timeSpent        Int?      @map("time_spent")
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([questionId])
  @@index([userId])
  @@map("question_attempts")
}

/// Progresso de um aluno em uma questão: contadores de tentativas (certo/
/// errado), último acesso e favorito. 1:1 por par (usuário, questão). É o que
/// alimenta as futuras análises da LuminIA (padrões de erro, revisões,
/// recomendações) sem remodelar o banco depois.
model UserQuestionProgress {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  attempts          Int       @default(0)
  correctAttempts   Int       @default(0) @map("correct_attempts")
  incorrectAttempts Int       @default(0) @map("incorrect_attempts")
  lastAttemptAt     DateTime? @map("last_attempt_at")
  isFavorite        Boolean   @default(false) @map("is_favorite")
  /// Marcada para revisão: o aluno sinalizou que quer voltar a esta questão.
  /// Diferente de `isFavorite` (guarda o que ele achou interessante): aqui o
  /// registro é um compromisso de retomada, alimentando a lista "Para revisar".
  markedForReview   Boolean   @default(false) @map("marked_for_review")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, isFavorite])
  @@index([userId, markedForReview])
  @@index([questionId])
  @@map("user_question_progress")
}

/// Item 13 do inventário: por que o aluno errou. É enum (e não texto livre)
/// porque o valor do agrupamento é a classificação; o que não couber na lista
/// vira OUTRO, com a explicação em `notes`.
enum ErrorReason {
  FALTA_CONTEUDO
  ERRO_INTERPRETACAO
  ERRO_CALCULO
  FALTA_ATENCAO
  CHUTE
  TEMPO_INSUFICIENTE
  CONFUSAO_CONCEITOS
  OUTRO
}

/// ABERTA: errou e ainda não acertou o bastante para considerar resolvida.
/// DOMINADA: acertou `ERROR_NOTEBOOK_MASTERED_STREAK` vezes seguidas depois
/// do erro — continua no histórico (a evolução é o que prova o progresso),
/// mas sai da fila do que precisa ser refeito.
enum ErrorNotebookStatus {
  ABERTA
  DOMINADA
}

/// Item 12 do inventário: caderno de erros. Uma linha por par (aluno,
/// questão), criada sozinha no primeiro erro e mantida nas repetições —
/// guarda o motivo do erro, a observação pessoal, a revisão combinada e a
/// evolução das tentativas (`evolution`, texto curto tipo "EEAA").
/// A dificuldade é a da questão (fonte única), mostrada e filtrada pela
/// interface a partir daqui.
model ErrorNotebookEntry {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  questionId        String               @map("question_id") @db.Uuid
  reason            ErrorReason?
  /// Observação pessoal do aluno ("refiz o cálculo e errei o sinal").
  notes             String?
  status            ErrorNotebookStatus  @default(ABERTA)
  /// Quantas vezes o aluno errou esta questão desde que ela entrou no caderno.
  wrongAttempts     Int                  @default(1) @map("wrong_attempts")
  /// Acertos seguidos desde o último erro (evolução da retomada).
  correctStreak     Int                  @default(0) @map("correct_streak")
  /// Linha do tempo em caracteres: "E" = erro, "A" = acerto. Truncada em 40.
  evolution         String               @default("")
  /// Revisão combinada pelo aluno (o item "criar revisão futura").
  reviewScheduledAt DateTime?            @map("review_scheduled_at")
  firstWrongAt      DateTime             @default(now()) @map("first_wrong_at")
  lastWrongAt       DateTime             @default(now()) @map("last_wrong_at")
  resolvedAt        DateTime?            @map("resolved_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  question          Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanResults       QuestionScanResult[]

  @@unique([userId, questionId])
  @@index([userId, status])
  @@index([userId, reviewScheduledAt])
  @@index([questionId])
  @@map("error_notebook_entries")
}

/// Item 32 do inventário: flashcard pessoal. O cartão é do aluno, não do
/// workspace: pode vir de uma questão acessível (erro), de texto digitado ou
/// de uma geração da LuminIA, mas a revisão é sempre individual.
enum FlashcardSource {
  MANUAL
  ERROR_NOTEBOOK
  AI
}

/// Nota da revisão. `AGAIN` significa que o aluno não lembrou; `HARD`,
/// `GOOD` e `EASY` significam que lembrou, com esforço decrescente.
enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model Flashcard {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  subjectId        String?           @map("subject_id") @db.Uuid
  topicId          String?           @map("topic_id") @db.Uuid
  /// Questão de origem quando o cartão foi criado a partir de um erro.
  sourceQuestionId String?           @map("source_question_id") @db.Uuid
  source           FlashcardSource   @default(MANUAL)
  front            String
  back             String
  /// Metadados de geração/auditoria (modelo, prompt, status de revisão).
  metadata         Json?
  reviewCount      Int               @default(0) @map("review_count")
  correctCount     Int               @default(0) @map("correct_count")
  /// Acertos seguidos em GOOD/EASY; AGAIN e HARD reiniciam.
  streak           Int               @default(0)
  intervalDays     Int               @default(0) @map("interval_days")
  easeFactor       Float             @default(2.5) @map("ease_factor")
  nextReviewAt     DateTime?         @map("next_review_at")
  lastReviewedAt   DateTime?         @map("last_reviewed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceQuestion   Question?         @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  reviews          FlashcardReview[]

  @@unique([userId, sourceQuestionId])
  @@index([userId, nextReviewAt])
  @@index([userId, subjectId])
  @@index([userId, topicId])
  @@map("flashcards")
}

/// Histórico de revisões: uma linha por resposta do aluno. É a partir dele que
/// a interface mostra a curva de retenção e a evolução do intervalo, sem
/// reescrever o passado quando o cartão é editado.
model FlashcardReview {
  id           String          @id @default(uuid()) @db.Uuid
  flashcardId  String          @map("flashcard_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  rating       FlashcardRating
  reviewedAt   DateTime        @default(now()) @map("reviewed_at")
  intervalDays Int             @map("interval_days")
  easeFactor   Float           @map("ease_factor")
  nextReviewAt DateTime?       @map("next_review_at")
  flashcard    Flashcard       @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flashcardId, reviewedAt])
  @@index([userId, reviewedAt])
  @@map("flashcard_reviews")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum AccountType {
  STUDENT_INDEPENDENT
  STUDENT_INSTITUTION
  TEACHER
  COORDINATOR
  DIRECTOR
  ADMIN
}

/// PENDING: conta institucional criada mas ainda não aprovada/ativada —
/// licenciamento institucional é sempre uma relação paga, tipicamente com
/// um passo de aprovação/onboarding assistido antes de ativar de fato.
enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED

  @@map("institution_status")
}

enum WorkspaceType {
  PERSONAL
  INSTITUTION

  @@map("workspace_type")
}

/// INVITED: convite enviado mas ainda não aceito pelo usuário.
enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("workspace_member_status")
}

enum QuestionDifficulty {
  FACIL
  MEDIA
  DIFICIL

  @@map("question_difficulty")
}

/// Origem de uma questão do banco. Define quem forneceu o conteúdo e
/// controla as permissões de uso (nunca copiar de fontes sem autorização):
/// - OFFICIAL: conteúdo curado/produzido pelo próprio Lumina (ex: questões
/// de provas oficiais licenciadas, ou autorais da equipe);
/// - PARTNER: conteúdo fornecido por instituições parceiras;
/// - GENERATED: questões geradas pela LuminIA (nunca tratadas como oficiais);
/// - IMPORTED: conteúdo importado de datasets/fontes externas autorizadas.
enum QuestionSourceType {
  OFFICIAL
  PARTNER
  GENERATED
  IMPORTED

  @@map("question_source_type")
}

/// Status de um cronograma de estudo do aluno.
enum StudyScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("study_schedule_status")
}

/// Status de uma tarefa de estudo.
enum StudyTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  /// O aluno decidiu não fazer (replanejamento, fase 4 §12). Fica registrada
  /// em vez de apagada, mas não conta como tarefa perdida nem como concluída.
  SKIPPED

  @@map("study_task_status")
}

/// Área do ENEM que o aluno pode marcar como prioritária no onboarding (fase 5,
/// §11) — entra como `pesoObjetivo` na prioridade dos tópicos (§4).
enum StudyArea {
  LINGUAGENS
  MATEMATICA
  NATUREZA
  HUMANAS

  @@map("study_area")
}

/// Frequência da rotina de redação (fase 5, §9).
enum StudyEssayFrequency {
  WEEKLY
  BIWEEKLY

  @@map("study_essay_frequency")
}

/// Cronograma de estudo pessoal de um aluno, sempre associado ao ENEM
/// (um por usuário via userId unique). Contém a data de início/término,
/// os dias da semana disponíveis e a duração diária planejada.
model StudySchedule {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @unique @map("user_id") @db.Uuid
  startDate        DateTime                  @map("start_date") @db.Date
  endDate          DateTime                  @map("end_date") @db.Date
  studyDays        Json                      @map("study_days")
  dailyMinutes     Int                       @map("daily_minutes")
  objective        String?
  /// Onboarding (fase 5, §11): curso que o aluno quer e as áreas que ele
  /// quer priorizar (até três). Ambos opcionais.
  targetCourse     String?                   @map("target_course")
  priorityAreas    StudyArea[]               @default([]) @map("priority_areas")
  /// Tópicos (Topic.id) que o aluno tirou do próprio cronograma: o gerador
  /// não os agenda e eles não contam nos indicadores de domínio.
  excludedTopicIds String[]                  @default([]) @map("excluded_topic_ids") @db.Uuid
  /// Rotina de redação (§9). Nulo com Redação no plano = semanal.
  essayFrequency   StudyEssayFrequency?      @map("essay_frequency")
  status           StudyScheduleStatus       @default(ACTIVE)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleSubjects StudyScheduleSubject[]
  dayMinutes       StudyScheduleDayMinutes[]
  sessions         StudySession[]
  tasks            StudyTask[]
  progress         StudyProgress?

  @@index([userId])
  @@map("study_schedules")
}

/// Disciplina estruturada do ENEM usada no cronograma de estudos.
/// Catálogo fixo (12 matérias) separado de Subject (classificação de
/// questões) — Redação, por exemplo, não tem questões mas é estudável.
model StudySubject {
  id               String                 @id @default(uuid()) @db.Uuid
  name             String                 @unique
  code             String                 @unique @map("code")
  displayOrder     Int                    @default(99) @map("display_order")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  scheduleSubjects StudyScheduleSubject[]
  sessionSubjects  StudySessionSubject[]
  tasks            StudyTask[]
  timeLogs         StudyTimeLog[]

  @@map("study_subjects")
}

/// Associação between StudySchedule e StudySubject: quais disciplinas
/// o aluno escolheu estudar e quantas horas pretende dedicar a cada uma.
model StudyScheduleSubject {
  id          String        @id @default(uuid()) @db.Uuid
  scheduleId  String        @map("schedule_id") @db.Uuid
  subjectId   String        @map("subject_id") @db.Uuid
  targetHours Float         @map("target_hours")
  createdAt   DateTime      @default(now()) @map("created_at")
  subject     StudySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedule    StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, subjectId])
  @@index([scheduleId])
  @@index([subjectId])
  @@map("study_schedule_subjects")
}

/// Tempo de estudo por dia da semana (onboarding, fase 5 §11: "Segunda: 2h,
/// Terça: 1h30..."). Opcional: sem linhas aqui, vale `dailyMinutes` igual
/// para todo dia de estudo, como sempre foi.
model StudyScheduleDayMinutes {
  id         String        @id @default(uuid()) @db.Uuid
  scheduleId String        @map("schedule_id") @db.Uuid
  /// 0 = domingo ... 6 = sábado (mesma convenção de StudySchedule.studyDays).
  weekday    Int
  minutes    Int
  schedule   StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@map("study_schedule_day_minutes")
}

/// Sessão de estudo planejada para um dia específico dentro do cronograma.
/// Uma por dia de estudo (unique em scheduleId + date).
model StudySession {
  id               String                @id @default(uuid()) @db.Uuid
  scheduleId       String                @map("schedule_id") @db.Uuid
  date             DateTime              @map("date") @db.Date
  scheduledMinutes Int                   @default(0) @map("scheduled_minutes")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  schedule         StudySchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sessionSubjects  StudySessionSubject[]
  tasks            StudyTask[]

  @@unique([scheduleId, date])
  @@index([scheduleId, date])
  @@map("study_sessions")
}

/// Disciplinas alocadas a uma sessão de estudo (quantos minutos por matéria
/// no dia). Tabela de junção entre StudySession e StudySubject.
model StudySessionSubject {
  id               String       @id @default(uuid()) @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  subjectId        String       @map("subject_id") @db.Uuid
  estimatedMinutes Int          @default(0) @map("estimated_minutes")
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject          StudySubject @relation(fields: [subjectId], references: [id])

  @@unique([sessionId, subjectId])
  @@index([sessionId])
  @@index([subjectId])
  @@map("study_session_subjects")
}

/// Tarefa de estudo individual — pode ser auto-gerada (baseada em tópicos
/// do banco) ou criada manualmente pelo aluno.
model StudyTask {
  id               String            @id @default(uuid()) @db.Uuid
  scheduleId       String            @map("schedule_id") @db.Uuid
  sessionId        String            @map("session_id") @db.Uuid
  subjectId        String?           @map("subject_id") @db.Uuid
  /// Aponta para o catálogo de questões (Topic), não para StudySubject — é
  /// de lá que vem TopicMastery (cronograma adaptativo, fase 2, ver
  /// docs/CRONOGRAMA_ADAPTATIVO_DESIGN.md §2). Nulo em tarefas sem tópico
  /// específico (redação, revisão geral, tarefa manual do aluno).
  topicId          String?           @map("topic_id") @db.Uuid
  /// Tipo da atividade (fase 2, §5-6) — antes disso só existia "estudar a
  /// matéria"; agora cada bloco tem um verbo (teoria, questões, revisão...).
  activityType     StudyActivityType @default(QUESTOES) @map("activity_type")
  title            String
  description      String?
  status           StudyTaskStatus   @default(PENDING)
  scheduledMinutes Int               @default(0) @map("scheduled_minutes")
  completedAt      DateTime?         @map("completed_at")
  /// Resultado do bloco de questões quando a tarefa foi concluída pela
  /// prática: respondidas e acertos. Nulo = concluída à mão.
  practiceAnswered Int?              @map("practice_answered")
  practiceCorrect  Int?              @map("practice_correct")
  /// Simulado montado para a tarefa de "Simulado"; enviá-lo conclui a tarefa.
  simulationId     String?           @map("simulation_id") @db.Uuid
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  schedule         StudySchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  session          StudySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject          StudySubject?     @relation(fields: [subjectId], references: [id])
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  simulation       Simulation?       @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  timeLogs         StudyTimeLog[]

  @@index([scheduleId])
  @@index([sessionId])
  @@index([subjectId])
  @@index([topicId])
  @@index([simulationId])
  @@map("study_tasks")
}

enum StudyActivityType {
  TEORIA
  QUESTOES
  REVISAO
  SIMULADO
  REDACAO
}

/// Registro de tempo de estudo real. O cronômetro trabalha por MATÉRIA, e
/// não por subtópico: o tempo é sempre atribuído a uma disciplina
/// (`subjectId`). `taskId` continua disponível para o registro antigo, ligado
/// à tarefa e — quando existir — à disciplina dela, mas passou a ser opcional:
/// um aluno pode estudar uma matéria do cronograma num dia sem sessão
/// (domingo, feriado, revisão avulsa) e ainda assim querer registrar o tempo.
model StudyTimeLog {
  id              String        @id @default(uuid()) @db.Uuid
  taskId          String?       @map("task_id") @db.Uuid
  subjectId       String?       @map("subject_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  durationMinutes Int           @map("duration_minutes")
  createdAt       DateTime      @default(now()) @map("created_at")
  task            StudyTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subject         StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([subjectId])
  @@index([userId])
  @@map("study_time_logs")
}

/// Progresso agregado do aluno no seu cronograma — usado na tela de
/// acompanhamento (percentual concluído, horas estudadas, streak).
model StudyProgress {
  id                    String        @id @default(uuid()) @db.Uuid
  scheduleId            String        @unique @map("schedule_id") @db.Uuid
  completedMinutes      Int           @default(0) @map("completed_minutes")
  totalScheduledMinutes Int           @default(0) @map("total_scheduled_minutes")
  streakDays            Int           @default(0) @map("streak_days")
  lastStudyDate         DateTime?     @map("last_study_date") @db.Date
  completedTasks        Int           @default(0) @map("completed_tasks")
  totalTasks            Int           @default(0) @map("total_tasks")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  schedule              StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("study_progress")
}

/// Vestibular escolhido pelo aluno no onboarding. Referência ao nome do
/// exam (ex: "ENEM") para contextualizar o cronograma.
model UserVestibular {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  examId     String?   @map("exam_id") @db.Uuid
  customName String?   @map("custom_name") // ex: "ENEM 2025" se for custom
  targetDate DateTime? @map("target_date") @db.Date // data da prova
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  exam       Exam?     @relation(fields: [examId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_vestibulares")
}

enum AssessmentType {
  ACTIVITY
  LIST
  TEST
  SIMULATION
  ADAPTIVE
}

/// Sessão de simulado adaptativo: o nível de dificuldade muda em tempo real
/// conforme o desempenho do aluno. Cada passo escolhe a próxima questão
/// baseada no histórico de acertos/erros por habilidade.
model AdaptiveSimulationSession {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Exame alvo (ENEM, FUVEST, etc.) — define o catálogo de habilidades.
   */
  examId           String?                  @map("exam_id") @db.Uuid
  exam             Exam?                    @relation(fields: [examId], references: [id])
  status           AdaptiveSessionStatus    @default(IN_PROGRESS)
  /**
   * Estimativa atual do nível do aluno (0.0 a 1.0, estilo IRT simplificado).
   */
  estimatedAbility Float                    @default(0.5) @map("estimated_ability")
  /**
   * Habilidades avaliadas até agora: JSON { habilidade: { correct, total, ability } }.
   */
  skills           Json                     @default("{}")
  startedAt        DateTime                 @default(now()) @map("started_at")
  finishedAt       DateTime?                @map("finished_at")
  steps            AdaptiveSimulationStep[]

  @@index([userId, status])
  @@map("adaptive_simulation_sessions")
}

/// Cada passo do simulado adaptativo: a questão apresentada, a resposta e o
/// efeito na estimativa de habilidade.
model AdaptiveSimulationStep {
  id               String                    @id @default(uuid()) @db.Uuid
  sessionId        String                    @map("session_id") @db.Uuid
  session          AdaptiveSimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String                    @map("user_id") @db.Uuid
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String                    @map("question_id") @db.Uuid
  question         Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /**
   * Dificuldade da questão no momento da apresentação (FACIL/MEDIA/DIFICIL).
   */
  difficulty       QuestionDifficulty
  /**
   * Habilidade principal testada (ex.: "Funções exponenciais").
   */
  skill            String
  /**
   * Sub-habilidade mais granular (opcional).
   */
  subSkill         String?                   @map("sub_skill")
  selectedPosition Int                       @map("selected_position")
  isCorrect        Boolean                   @map("is_correct")
  /**
   * Estimativa de habilidade ANTES desta questão.
   */
  abilityBefore    Float                     @map("ability_before")
  /**
   * Estimativa de habilidade DEPOIS desta questão.
   */
  abilityAfter     Float                     @map("ability_after")
  timeSpentSeconds Int?                      @map("time_spent_seconds")
  createdAt        DateTime                  @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("adaptive_simulation_steps")
}

/// Modelo de gabarito (template) para folha de respostas.
/// Define a posição dos marcadores de referência e das bolhas de resposta.
model AnswerSheetTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(120)
  description    String?             @db.Text
  /**
   * JSON com coordenadas normalizadas (0-1) dos 4 marcadores de canto para alinhamento:
   * { topLeft: {x,y}, topRight: {x,y}, bottomLeft: {x,y}, bottomRight: {x,y} }
   */
  markersJson    Json
  /**
   * JSON com layout das bolhas por questão:
   * [{ questionNumber: 1, bubbles: [{ position: 1, x, y, radius }, ...] }, ...]
   */
  layoutJson     Json
  /**
   * Dimensões esperadas da imagem (px) para validação rápida.
   */
  expectedWidth  Int?
  expectedHeight Int?
  /**
   * Preenchido só quando o template foi gerado automaticamente na criação de
   * um simulado (item professor/coordenador/diretor) — nulo nos templates
   * reutilizáveis criados manualmente pelo scanner de cartão-resposta.
   */
  simulationId   String?             @unique @map("simulation_id") @db.Uuid
  simulation     Simulation?         @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  uploads        AnswerSheetUpload[]
  codes          AnswerSheetCode[]

  @@map("answer_sheet_templates")
}

/// Upload de imagem de cartão-resposta pelo aluno/professor.
model AnswerSheetUpload {
  id           String                 @id @default(uuid()) @db.Uuid
  templateId   String                 @map("template_id") @db.Uuid
  template     AnswerSheetTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  simulationId String?                @map("simulation_id") @db.Uuid
  simulation   Simulation?            @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  studentId    String                 @map("student_id") @db.Uuid
  student      User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /**
   * URL do arquivo original (storage).
   */
  fileUrl      String
  /**
   * Metadados da imagem: { width, height, mimeType, sizeBytes }.
   */
  metaJson     Json
  status       AnswerSheetStatus      @default(PENDING)
  /// Quem fotografou (o próprio aluno ou o professor que escaneou a folha dele).
  scannedById  String?                @map("scanned_by_id") @db.Uuid
  scannedBy    User?                  @relation("AnswerSheetScanner", fields: [scannedById], references: [id], onDelete: SetNull)
  /// Código lido na faixa do cartão (AnswerSheetCode.code).
  sheetCode    Int?                   @map("sheet_code")
  /// PDF de onde a folha veio (várias folhas podem vir no mesmo PDF).
  batchId      String?                @map("batch_id") @db.Uuid
  batch        AnswerSheetBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  pageIndex    Int?                   @map("page_index")
  /// Página digitalizada no aparelho (JPEG), para a revisão e a auditoria.
  image        Bytes?
  imageMime    String?                @map("image_mime") @db.VarChar(40)
  /**
   * Processamento associado (1:1 quando concluído).
   */
  processing   AnswerSheetProcessing?
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@index([simulationId, studentId])
  @@index([studentId, createdAt])
  @@map("answer_sheet_uploads")
}

/// Resultado do processamento OCR de um cartão-resposta.
model AnswerSheetProcessing {
  id                 String                      @id @default(uuid()) @db.Uuid
  uploadId           String                      @unique @map("upload_id") @db.Uuid
  upload             AnswerSheetUpload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  submission         AnswerSheetSubmission?
  /**
   * Respostas detectadas: { questionNumber: selectedPosition (1-5) }.
   */
  detectedAnswers    Json
  /**
   * Confiança por questão: { questionNumber: 0.0-1.0 }.
   */
  confidenceJson     Json
  /**
   * Alertas: bolhas não marcadas, múltiplas marcas, baixa confiança.
   */
  warningsJson       Json
  /**
   * Total de questões do gabarito.
   */
  totalQuestions     Int
  /**
   * Quantas questões tiveram resposta detectada.
   */
  answeredCount      Int
  /**
   * Quantas questões têm confiança baixa (< 0.7).
   */
  lowConfidenceCount Int
  /// Leitura por questão: [{ number, selected, status, confidence, fills, box }].
  detailsJson        Json?                       @map("details_json")
  /// Limiar de marcação adotado na folha (OMR).
  threshold          Float?
  /// Questões que o corretor mudou em relação à leitura (auditoria).
  adjustedJson       Json?                       @map("adjusted_json")
  status             AnswerSheetProcessingStatus @default(PROCESSING)
  errorMessage       String?
  startedAt          DateTime                    @default(now()) @map("started_at")
  finishedAt         DateTime?                   @map("finished_at")

  @@map("answer_sheet_processings")
}

/// Submissão de simulado via cartão-resposta físico (link com SimulationSubmission).
model AnswerSheetSubmission {
  id           String                @id @default(uuid()) @db.Uuid
  processingId String                @unique @map("processing_id") @db.Uuid
  processing   AnswerSheetProcessing @relation(fields: [processingId], references: [id], onDelete: Cascade)
  simulationId String                @map("simulation_id") @db.Uuid
  simulation   Simulation            @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  studentId    String                @map("student_id") @db.Uuid
  student      User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /**
   * Respostas finais após revisão humana (se houver).
   */
  finalAnswers Json
  correct      Int
  total        Int
  submittedAt  DateTime              @default(now()) @map("submitted_at")
  reviewedBy   String?               @map("reviewed_by") @db.Uuid
  reviewer     User?                 @relation("AnswerSheetReview", fields: [reviewedBy], references: [id])
  reviewedAt   DateTime?             @map("reviewed_at")
  /// Lançamento final: quando o domínio por tópico foi aplicado com as
  /// respostas definitivas. Depois disso a folha não aceita mais ajuste.
  finalizedAt  DateTime?             @map("finalized_at")

  @@index([simulationId, studentId])
  @@index([studentId, submittedAt])
  @@map("answer_sheet_submissions")
}

enum AnswerSheetStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum AnswerSheetProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AdaptiveSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Upload de imagem de questão impressa (item 18 do inventário).
model QuestionScanUpload {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * URL do arquivo original (storage).
   */
  fileUrl    String
  /**
   * Metadados da imagem: { width, height, mimeType, sizeBytes }.
   */
  metaJson   Json
  status     QuestionScanStatus      @default(PENDING)
  /**
   * Processamento associado (1:1 quando concluído).
   */
  processing QuestionScanProcessing?
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("question_scan_uploads")
}

/// Resultado do processamento OCR/IA de uma questão.
model QuestionScanProcessing {
  id               String                       @id @default(uuid()) @db.Uuid
  uploadId         String                       @unique @map("upload_id") @db.Uuid
  upload           QuestionScanUpload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  /**
   * Texto extraído do enunciado (OCR).
   */
  stemText         String?
  /**
   * Alternativas extraídas: [{ position: 1, text: "..." }, ...].
   */
  alternativesJson Json?
  /**
   * Disciplina identificada (ex.: "Matemática", "Física").
   */
  subject          String?
  /**
   * Assunto identificado (ex.: "Funções exponenciais", "Termodinâmica").
   */
  topic            String?
  /**
   * Dificuldade estimada.
   */
  difficulty       QuestionDifficulty?
  /**
   * Explicação gerada pela LuminIA (por alternativa ou geral).
   */
  explanationJson  Json?
  /**
   * Confiança global do processamento (0.0-1.0).
   */
  confidence       Float?
  /**
   * Alertas: texto cortado, alternativas incompletas, baixa confiança OCR.
   */
  warningsJson     Json?
  status           QuestionScanProcessingStatus @default(PROCESSING)
  errorMessage     String?
  startedAt        DateTime                     @default(now()) @map("started_at")
  finishedAt       DateTime?                    @map("finished_at")
  result           QuestionScanResult?

  @@map("question_scan_processings")
}

/// Questão salva a partir do scanner — pode virar questão do banco ou entrar no caderno de erros.
model QuestionScanResult {
  id                   String                 @id @default(uuid()) @db.Uuid
  processingId         String                 @unique @map("processing_id") @db.Uuid
  processing           QuestionScanProcessing @relation(fields: [processingId], references: [id], onDelete: Cascade)
  userId               String                 @map("user_id") @db.Uuid
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Se virou questão oficial do banco.
   */
  questionId           String?                @map("question_id") @db.Uuid
  question             Question?              @relation(fields: [questionId], references: [id], onDelete: SetNull)
  /**
   * Se entrou no caderno de erros.
   */
  errorNotebookEntryId String?                @map("error_notebook_entry_id") @db.Uuid
  errorNotebookEntry   ErrorNotebookEntry?    @relation(fields: [errorNotebookEntryId], references: [id], onDelete: SetNull)
  /**
   * Dados finais salvos (pode ter sido editado pelo usuário).
   */
  finalStem            String
  finalAlternatives    Json
  finalSubject         String
  finalTopic           String
  finalDifficulty      QuestionDifficulty
  finalExplanation     Json?
  savedAt              DateTime               @default(now()) @map("saved_at")

  @@index([userId, savedAt])
  @@map("question_scan_results")
}

enum QuestionScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionScanProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// Item 19: Provas antigas — Experiência completa de prova
// =============================================================================

/// Edição de uma prova (ex.: ENEM 2023, FUVEST 2024). Uma prova pode ter
/// várias edições (anos). Contém metadados, PDF/imagens e gabarito oficial.
model ExamPaper {
  id                 String                @id @default(uuid()) @db.Uuid
  examId             String                @map("exam_id") @db.Uuid
  exam               Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  year               Int
  /**
   * PDF completo da prova (storage URL).
   */
  pdfUrl             String?
  /**
   * Imagens das páginas (storage URLs).
   */
  pageImagesJson     Json?
  /**
   * Metadados: { totalPages, hasGabarito, hasCaderno, sourceUrl }.
   */
  metadataJson       Json?
  /**
   * Gabarito oficial: { questionNumber: correctPosition }.
   */
  gabaritoJson       Json?
  /**
   * Caderno de questões (separado do gabarito).
   */
  cadernoJson        Json?
  /// Edição dentro do ano (ex.: "D1" e "D2" para os dois dias do ENEM).
  /// Vazio nas provas de um caderno só.
  edition            String                @default("") @db.VarChar(40)
  status             ExamPaperStatus       @default(DRAFT)
  publishedAt        DateTime?             @map("published_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  pages              ExamPaperPage[]
  questions          ExamPaperQuestion[]
  baseComparisons    ExamPaperComparison[] @relation("ComparisonBase")
  compareComparisons ExamPaperComparison[] @relation("ComparisonCompare")

  @@unique([examId, year, edition])
  @@index([examId, year])
  @@map("exam_papers")
}

/// Página individual de uma prova (para navegação e zoom).
model ExamPaperPage {
  id             String    @id @default(uuid()) @db.Uuid
  paperId        String    @map("paper_id") @db.Uuid
  paper          ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  pageNumber     Int
  /**
   * URL da imagem da página (storage).
   */
  imageUrl       String
  /**
   * Dimensões: { width, height }.
   */
  dimensionsJson Json?
  /**
   * OCR/text extraído da página (para busca).
   */
  textContent    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([paperId, pageNumber])
  @@index([paperId])
  @@map("exam_paper_pages")
}

/// Mapeamento de questões para posições nas páginas da prova.
model ExamPaperQuestion {
  id         String    @id @default(uuid()) @db.Uuid
  paperId    String    @map("paper_id") @db.Uuid
  paper      ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questionId String    @map("question_id") @db.Uuid
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /**
   * Número da questão na prova (1, 2, 3...).
   */
  number     Int
  /**
   * Página onde a questão aparece.
   */
  pageNumber Int
  /**
   * Coordenadas normalizadas (0-1) da questão na página: { x, y, width, height }.
   */
  boundsJson Json?
  /**
   * Área do conhecimento (ex.: "Matemática e suas Tecnologias").
   */
  area       String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([paperId, number])
  @@index([paperId, pageNumber])
  @@map("exam_paper_questions")
}

/// Comparação entre edições da mesma prova (ex.: ENEM 2022 vs 2023).
model ExamPaperComparison {
  id              String    @id @default(uuid()) @db.Uuid
  basePaperId     String    @map("base_paper_id") @db.Uuid
  basePaper       ExamPaper @relation("ComparisonBase", fields: [basePaperId], references: [id], onDelete: Cascade)
  comparePaperId  String    @map("compare_paper_id") @db.Uuid
  comparePaper    ExamPaper @relation("ComparisonCompare", fields: [comparePaperId], references: [id], onDelete: Cascade)
  /**
   * Tipo: SIMILAR_QUESTIONS, DIFFICULTY_SHIFT, TOPIC_CHANGE, NEW_TOPICS.
   */
  type            String
  /**
   * Detalhes da comparação (JSON).
   */
  detailsJson     Json
  similarityScore Float?    @map("similarity_score")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([basePaperId, comparePaperId])
  @@index([basePaperId])
  @@index([comparePaperId])
  @@map("exam_paper_comparisons")
}

enum ExamPaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// =============================================================================
// Item 20: Redação — Correção por competências ENEM
// =============================================================================

/// Correção de uma redação por competências (ENEM: C1 a C5).
model EssayCorrection {
  id               String                  @id @default(uuid()) @db.Uuid
  essayId          String                  @unique @map("essay_id") @db.Uuid
  essay            Essay                   @relation(fields: [essayId], references: [id], onDelete: Cascade)
  /**
   * Correção por competência (C1 a C5): { C1: 200, C2: 180, C3: 160, C4: 140, C5: 120 }.
   */
  competenciesJson Json
  /**
   * Nota total (soma das competências, máx 1000).
   */
  totalScore       Int
  /**
   * Status da correção.
   */
  status           EssayCorrectionStatus   @default(PENDING)
  /**
   * Corretor (IA ou professor).
   */
  correctedBy      String?                 @map("corrected_by")
  /**
   * Correção feita por IA.
   */
  isAiCorrection   Boolean                 @default(false) @map("is_ai_correction")
  /**
   * Confiança da correção (0-1).
   */
  confidence       Float?
  /**
   * Comentários gerais.
   */
  generalFeedback  String?                 @map("general_feedback")
  /// Anulação (nota zero total): { code, explanation, citation }.
  annulmentJson    Json?                   @map("annulment_json")
  /// Auditoria: avaliadores, discrepância, chamadas às ferramentas MCP,
  /// análise do texto e modelos usados. Permite refazer o raciocínio da nota.
  auditJson        Json?                   @map("audit_json")
  /// Versão da redação que foi corrigida (Essay.version naquele momento).
  essayVersion     Int?                    @map("essay_version")
  errorMessage     String?                 @map("error_message")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  details          EssayCorrectionDetail[]
  reviews          EssayReview[]
  reviewMessages   EssayReviewMessage[]
  learningRecords  EssayLearningRecord[]

  @@map("essay_corrections")
}

/// Detalhe por competência com justificativa.
model EssayCorrectionDetail {
  id            String          @id @default(uuid()) @db.Uuid
  correctionId  String          @map("correction_id") @db.Uuid
  correction    EssayCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  /**
   * Competência: C1, C2, C3, C4, C5.
   */
  competency    String
  /**
   * Nota da competência (0-200).
   */
  score         Int
  /**
   * Justificativa da nota.
   */
  justification String?
  /**
   * Exemplos de trechos da redação que fundamentam a nota.
   */
  evidenceJson  Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([correctionId, competency])
  @@index([correctionId])
  @@map("essay_correction_details")
}

/// Versão de uma redação (histórico de edições).
model EssayVersion {
  id        String   @id @default(uuid()) @db.Uuid
  essayId   String   @map("essay_id") @db.Uuid
  essay     Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  wordCount Int      @map("word_count")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  @@unique([essayId, version])
  @@index([essayId])
  @@map("essay_versions")
}

/// Feedback (IA ou professor) sobre uma redação.
model EssayFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  essayId    String   @map("essay_id") @db.Uuid
  essay      Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)
  /**
   * Tipo: AI_SUGGESTION, TEACHER_COMMENT, PEER_REVIEW.
   */
  type       String
  /**
   * Autor do feedback (se professor/peer).
   */
  authorId   String?  @map("author_id") @db.Uuid
  author     User?    @relation("EssayFeedbackAuthor", fields: [authorId], references: [id])
  /**
   * Conteúdo do feedback.
   */
  content    String
  /**
   * Referência a trecho específico (opcional).
   */
  anchorJson Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([essayId, createdAt])
  @@map("essay_feedbacks")
}

// =============================================================================
// Item 21: avaliação humana colaborativa e aprendizagem contínua
// =============================================================================

/// Revisão de uma correção por um avaliador humano. A correção da IA continua
/// sendo a referência; a revisão é uma contribuição versionada e auditável.
/// O snapshot das notas da IA evita que uma nova correção sobrescreva o
/// histórico de uma revisão já feita.
model EssayReview {
  id                 String                @id @default(uuid()) @db.Uuid
  essayId            String                @map("essay_id") @db.Uuid
  essay              Essay                 @relation(fields: [essayId], references: [id], onDelete: Cascade)
  correctionId       String                @map("correction_id") @db.Uuid
  correction         EssayCorrection       @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  essayVersion       Int                   @map("essay_version")
  evaluatorId        String                @map("evaluator_id") @db.Uuid
  evaluator          User                  @relation("EssayReviewEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatorRole      AccountType           @map("evaluator_role")
  status             EssayReviewStatus     @default(DRAFT)
  decision           EssayReviewDecision?
  /// Snapshot da correção da IA no momento da revisão: { C1: 120, ... }.
  aiCompetenciesJson Json                  @map("ai_competencies_json")
  aiTotalScore       Int                   @map("ai_total_score")
  aiGeneralFeedback  String?               @map("ai_general_feedback")
  /// Notas propostas pelo avaliador: { C1: 160, ... }.
  competenciesJson   Json                  @map("competencies_json")
  totalScore         Int                   @map("total_score")
  generalFeedback    String?               @map("general_feedback")
  /// Divergências calculadas: total, por competência e se é discrepante.
  divergenceJson     Json?                 @map("divergence_json")
  /// Nível de validação do conhecimento gerado pela revisão.
  validationLevel    EssayLearningLevel    @default(RECEIVED) @map("validation_level")
  validatedBy        String?               @map("validated_by") @db.Uuid
  validatedByUser    User?                 @relation("EssayReviewValidator", fields: [validatedBy], references: [id], onDelete: SetNull)
  validatedAt        DateTime?             @map("validated_at")
  validationNotes    String?               @map("validation_notes")
  submittedAt        DateTime?             @map("submitted_at")
  supersededAt       DateTime?             @map("superseded_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  details            EssayReviewDetail[]
  messages           EssayReviewMessage[]
  learningRecords    EssayLearningRecord[]

  @@unique([correctionId, evaluatorId, essayVersion])
  @@index([essayId, status])
  @@index([validationLevel, updatedAt])
  @@map("essay_reviews")
}

/// Nota e justificativa do avaliador por competência, sempre acompanhadas da
/// nota original da IA para que a divergência não dependa de outra tabela.
model EssayReviewDetail {
  id              String                @id @default(uuid()) @db.Uuid
  reviewId        String                @map("review_id") @db.Uuid
  review          EssayReview           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  competency      String                @db.VarChar(2)
  aiScore         Int                   @map("ai_score")
  humanScore      Int                   @map("human_score")
  decision        EssayReviewDecision
  /// Critério discutido: "desenvolvimento argumentativo", "coesão", etc.
  criterion       String?               @db.VarChar(240)
  justification   String?
  /// Evidências textuais e âncoras selecionadas pelo avaliador.
  evidenceJson    Json?                 @map("evidence_json")
  createdAt       DateTime              @default(now()) @map("created_at")
  learningRecords EssayLearningRecord[]

  @@unique([reviewId, competency])
  @@index([reviewId])
  @@map("essay_review_details")
}

/// Mensagem do chat contextual avaliador ↔ LuminIA. O histórico bruto fica
/// separado dos aprendizados estruturados (EssayLearningRecord).
model EssayReviewMessage {
  id            String                 @id @default(uuid()) @db.Uuid
  essayId       String                 @map("essay_id") @db.Uuid
  essay         Essay                  @relation(fields: [essayId], references: [id], onDelete: Cascade)
  correctionId  String?                @map("correction_id") @db.Uuid
  correction    EssayCorrection?       @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  reviewId      String?                @map("review_id") @db.Uuid
  review        EssayReview?           @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  authorId      String?                @map("author_id") @db.Uuid
  author        User?                  @relation("EssayReviewMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  role          EssayReviewMessageRole
  content       String
  /// Referências oficiais e exemplos validados usados na resposta.
  citationsJson Json?                  @map("citations_json")
  /// Trecho da redação selecionado pelo avaliador.
  anchorJson    Json?                  @map("anchor_json")
  model         String?                @db.VarChar(200)
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([essayId, createdAt])
  @@index([reviewId, createdAt])
  @@map("essay_review_messages")
}

/// Aprendizado estruturado extraído de uma revisão ou de uma interação.
/// Não é uma regra global: nasce como RECEIVED/STRUCTURED e só entra na
/// recuperação (RAG) depois de VALIDATED/CONSOLIDATED, com consentimento e
/// anonimização registrados.
model EssayLearningRecord {
  id                 String                @id @default(uuid()) @db.Uuid
  essayId            String                @map("essay_id") @db.Uuid
  essay              Essay                 @relation(fields: [essayId], references: [id], onDelete: Cascade)
  correctionId       String?               @map("correction_id") @db.Uuid
  correction         EssayCorrection?      @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  reviewId           String?               @map("review_id") @db.Uuid
  review             EssayReview?          @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reviewDetailId     String?               @map("review_detail_id") @db.Uuid
  reviewDetail       EssayReviewDetail?    @relation(fields: [reviewDetailId], references: [id], onDelete: SetNull)
  competency         String                @db.VarChar(2)
  criterion          String?               @db.VarChar(240)
  aiScore            Int?                  @map("ai_score")
  humanScore         Int?                  @map("human_score")
  evidence           String?
  aiJustification    String?               @map("ai_justification")
  humanJustification String?               @map("human_justification")
  divergenceReason   String?               @map("divergence_reason")
  decision           EssayReviewDecision?
  /// Lição destilada, legível por humanos e usada no contexto da IA.
  learning           String
  confidence         Float?
  applicability      String?
  level              EssayLearningLevel    @default(RECEIVED)
  origin             String                @default("HUMAN_REVIEW") @db.VarChar(40)
  anonymized         Boolean               @default(false)
  consentAt          DateTime?             @map("consent_at")
  version            Int                   @default(1)
  supersedesId       String?               @map("supersedes_id") @db.Uuid
  supersedes         EssayLearningRecord?  @relation("EssayLearningVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  versions           EssayLearningRecord[] @relation("EssayLearningVersions")
  createdBy          String                @map("created_by") @db.Uuid
  createdByUser      User                  @relation("EssayLearningCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  validatedBy        String?               @map("validated_by") @db.Uuid
  validatedByUser    User?                 @relation("EssayLearningValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)
  validatedAt        DateTime?             @map("validated_at")
  archivedAt         DateTime?             @map("archived_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([competency, level, archivedAt])
  @@index([essayId, createdAt])
  @@map("essay_learning_records")
}

/// Trilha append-only de decisões sensíveis (quem revisou, validou, alterou
/// nível ou gerou aprendizado). Nunca é atualizada nem apagada pelo serviço.
model EssayAuditEvent {
  id           String           @id @default(uuid()) @db.Uuid
  actorId      String?          @map("actor_id") @db.Uuid
  actor        User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       EssayAuditAction
  entity       String           @db.VarChar(60)
  entityId     String           @map("entity_id") @db.VarChar(80)
  beforeJson   Json?            @map("before_json")
  afterJson    Json?            @map("after_json")
  metadataJson Json?            @map("metadata_json")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("essay_audit_events")
}

enum EssayReviewStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  DISPUTED
  SUPERSEDED
}

enum EssayReviewDecision {
  AGREE
  DISAGREE
  ADJUST
}

enum EssayReviewMessageRole {
  EVALUATOR
  AI
  SYSTEM
}

enum EssayLearningLevel {
  RECEIVED
  STRUCTURED
  VALIDATED
  CONSOLIDATED
}

enum EssayAuditAction {
  REVIEW_SUBMITTED
  REVIEW_VALIDATED
  REVIEW_CONSOLIDATED
  REVIEW_RESET
  LEARNING_CREATED
  LEARNING_ARCHIVED
  MESSAGE_CREATED
}

enum EssayCorrectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Redação fotografada: a foto digitalizada no aparelho (recorte, perspectiva
/// e realce estilo CamScanner) e a transcrição lida por modelo de visão. A
/// transcrição volta para o aluno conferir antes de virar Essay e ir para a
/// correção — a foto e o texto reconhecido ficam vinculados (scan → essay).
model EssayScan {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Redação criada ao confirmar a transcrição.
  essayId         String?         @map("essay_id") @db.Uuid
  essay           Essay?          @relation(fields: [essayId], references: [id], onDelete: SetNull)
  theme           String          @default("") @db.VarChar(300)
  status          EssayScanStatus @default(PROCESSING)
  /// Transcrição por linha: [{ number, text, paragraphStart, illegibleWords }].
  linesJson       Json?           @map("lines_json")
  transcribedText String?         @map("transcribed_text")
  title           String?         @db.VarChar(160)
  lineCount       Int?            @map("line_count")
  illegibleWords  Int?            @map("illegible_words")
  ocrConfidence   Float?          @map("ocr_confidence")
  ocrModel        String?         @map("ocr_model") @db.VarChar(300)
  warningsJson    Json?           @map("warnings_json")
  errorMessage    String?         @map("error_message")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  pages           EssayScanPage[]

  @@index([userId, createdAt])
  @@map("essay_scans")
}

/// Página digitalizada (JPEG já processado no aparelho). Separada do scan para
/// a listagem não carregar imagem e para o aluno poder apagar as fotos sem
/// perder o texto.
model EssayScanPage {
  id        String    @id @default(uuid()) @db.Uuid
  scanId    String    @map("scan_id") @db.Uuid
  scan      EssayScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  index     Int
  mimeType  String    @map("mime_type") @db.VarChar(40)
  sizeBytes Int       @map("size_bytes")
  image     Bytes
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([scanId, index])
  @@map("essay_scan_pages")
}

enum EssayScanStatus {
  PROCESSING
  READY
  CONFIRMED
  FAILED
}

/// Código impresso na faixa do cartão-resposta (20 bits): identifica o
/// simulado (pelo template) e, na folha personalizada, o aluno. Assim o
/// professor escaneia a folha de qualquer aluno sem dizer de quem é.
model AnswerSheetCode {
  code       Int                 @id
  templateId String              @map("template_id") @db.Uuid
  template   AnswerSheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Aluno da folha personalizada; nulo = folha genérica (vale para quem escanear).
  studentId  String?             @map("student_id") @db.Uuid
  student    User?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy  String              @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([templateId, studentId])
  @@map("answer_sheet_codes")
}

/// PDF enviado ao scanner de cartão-resposta (uma folha por página). Guardado
/// para auditoria e para o corretor baixar; cada página vira uma leitura.
model AnswerSheetBatch {
  id          String              @id @default(uuid()) @db.Uuid
  scannedById String              @map("scanned_by_id") @db.Uuid
  scannedBy   User                @relation(fields: [scannedById], references: [id], onDelete: Cascade)
  pdf         Bytes
  pages       Int
  sizeBytes   Int                 @map("size_bytes")
  createdAt   DateTime            @default(now()) @map("created_at")
  uploads     AnswerSheetUpload[]

  @@index([scannedById, createdAt])
  @@map("answer_sheet_batches")
}

/// Uso da cota mensal de correções por IA: uma linha por correção que
/// chamou o modelo. Fica separada de essay_corrections porque ali há uma
/// linha por redação (corrigir de novo sobrescreve), e a cota conta pedidos.
model EssayCorrectionUsage {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Apagar a redação não devolve a correção já gasta.
  essayId    String?   @map("essay_id") @db.Uuid
  essay      Essay?    @relation(fields: [essayId], references: [id], onDelete: SetNull)
  /// Mês da cota no fuso de Brasília, "AAAA-MM".
  period     String    @db.VarChar(7)
  /// Preenchido quando a correção não usou a IA (falhou ou caiu no modelo
  /// estatístico/regra): o crédito volta para o aluno.
  refundedAt DateTime? @map("refunded_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, period])
  @@map("essay_correction_usages")
}

// =============================================================================
// Gabarito Inteligente: gabaritos por prova/aplicação/dia/cor, conferência do
// aluno e histórico de desempenho.
// =============================================================================

/// De onde vem o gabarito. Só OFFICIAL é oficial; os demais aparecem sempre
/// marcados como não oficiais.
enum AnswerKeyOrigin {
  OFFICIAL
  TEACHER
  AI_SUGGESTED
  COMMUNITY
}

enum AnswerKeyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Gabarito de uma prova numa aplicação, dia e cor de caderno. O oficial é
/// único por (prova, aplicação, dia, cor) — índice parcial na migration — e,
/// quando a banca corrige, sobe de versão (as conferências guardam a versão).
model AnswerKey {
  id             String           @id @default(uuid()) @db.Uuid
  examId         String           @map("exam_id") @db.Uuid
  exam           Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  /// Edição/aplicação: "Regular", "Reaplicação/PPL", "Digital"…
  application    String           @default("Regular") @db.VarChar(60)
  /// Dia de prova (Enem: 1 ou 2); nulo para provas de um dia só.
  day            Int?
  /// Cor/modelo do caderno; nulo quando a prova não tem versões.
  bookletColor   String?          @map("booklet_color") @db.VarChar(30)
  /// Área do conhecimento, quando o gabarito é de uma área só.
  area           String?          @db.VarChar(80)
  origin         AnswerKeyOrigin
  status         AnswerKeyStatus  @default(DRAFT)
  /// Fonte (oficial: banca e link do documento).
  sourceName     String?          @map("source_name") @db.VarChar(120)
  sourceUrl      String?          @map("source_url") @db.VarChar(500)
  /// Data de publicação do gabarito pela banca.
  publishedAt    DateTime?        @map("published_at")
  version        Int              @default(1)
  /// O que mudou na última correção oficial.
  correctionNote String?          @map("correction_note")
  /// Instituição do professor (nulo para o oficial, que vale para todos).
  workspaceId    String?          @map("workspace_id") @db.Uuid
  createdBy      String           @map("created_by") @db.Uuid
  creator        User             @relation("AnswerKeyCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          AnswerKeyItem[]
  checks         AnswerKeyCheck[]
  votes          AnswerKeyVote[]

  @@index([examId, origin, status])
  @@index([createdBy])
  @@map("answer_keys")
}

/// Resposta de uma questão no gabarito. Nas questões de língua estrangeira do
/// Enem (1–5 do 1º dia) há um item por língua.
model AnswerKeyItem {
  id            String    @id @default(uuid()) @db.Uuid
  answerKeyId   String    @map("answer_key_id") @db.Uuid
  answerKey     AnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  number        Int
  /// "" = vale para todos; "INGLES" ou "ESPANHOL" nas questões de língua.
  language      String    @default("") @db.VarChar(10)
  /// 1 = A … 5 = E; nulo = questão anulada.
  answer        Int?
  area          String?   @db.VarChar(80)
  questionId    String?   @map("question_id") @db.Uuid
  question      Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  /// Justificativa (gabarito sugerido por IA ou pelo professor).
  justification String?
  /// Confiança (0–1) só quando há base para calcular.
  confidence    Float?
  /// Falso = aguardando validação (aparece em amarelo para o aluno).
  validated     Boolean   @default(true)
  /// Gabarito comunitário: quantos votos a questão recebeu.
  votes         Int?

  @@unique([answerKeyId, number, language])
  @@index([questionId])
  @@map("answer_key_items")
}

/// Uma conferência do aluno: respostas, resultado e a versão do gabarito usada.
model AnswerKeyCheck {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerKeyId      String    @map("answer_key_id") @db.Uuid
  answerKey        AnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  answerKeyVersion Int       @map("answer_key_version")
  /// Língua escolhida (Enem 1º dia).
  language         String?   @db.VarChar(10)
  /// "MANUAL" ou "PHOTO".
  inputMode        String    @default("MANUAL") @map("input_mode") @db.VarChar(10)
  /// { "número": 1–5 | null }.
  answersJson      Json      @map("answers_json")
  correct          Int
  wrong            Int
  blank            Int
  /// Questões com gabarito ainda não validado (não entram no percentual).
  pending          Int
  /// Questões anuladas (não entram no percentual).
  annulled         Int
  total            Int
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([answerKeyId])
  @@map("answer_key_checks")
}

/// Voto de um aluno no gabarito comunitário: a alternativa que ele marcou.
/// Um voto por aluno por questão (e língua); reenviar substitui.
model AnswerKeyVote {
  id          String    @id @default(uuid()) @db.Uuid
  answerKeyId String    @map("answer_key_id") @db.Uuid
  answerKey   AnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number      Int
  language    String    @default("") @db.VarChar(10)
  /// 1 = A … 5 = E.
  answer      Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([answerKeyId, userId, number, language])
  @@index([answerKeyId, number])
  @@map("answer_key_votes")
}

// ---------------------------------------------------------------- planos

/// FREE: limites do plano gratuito. PREMIUM: assinatura individual do aluno.
/// INSTITUTIONAL: licença da instituição, estendida aos alunos dela.
enum PlanTier {
  FREE
  PREMIUM
  INSTITUTIONAL
}

/// PENDING: aguardando o primeiro pagamento. PAST_DUE: cobrança vencida (o
/// acesso segue até current_period_end). CANCELED: recorrência encerrada (o
/// acesso já pago segue até current_period_end).
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// ASAAS: cobrança recorrente no Asaas. FOUNDER: benefício de fundador (sem
/// cobrança, com prazo). MANUAL: concessão da administração.
enum SubscriptionSource {
  ASAAS
  FOUNDER
  MANUAL
}

/// MONTHLY: assinatura recorrente mensal. YEARLY: plano anual, cobrado de
/// uma vez no cartão em até 12 parcelas (sem renovação automática).
enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Recursos com limite por plano. A correção de redação continua contada em
/// essay_correction_usages; só o limite dela vem do plano.
enum PlanFeature {
  ESSAY_CORRECTION
  SIMULATION
  LUMINIA_MESSAGE
  FLASHCARD_AI
}

/// Assinatura ou concessão de plano. Pertence a um usuário (individual) ou a
/// uma instituição (licença). A Lumina não guarda cartão nem CPF: eles ficam
/// no provedor; aqui ficam só os identificadores e o período pago.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String?            @map("user_id") @db.Uuid
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId          String?            @map("institution_id") @db.Uuid
  institution            Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  tier                   PlanTier
  status                 SubscriptionStatus @default(PENDING)
  source                 SubscriptionSource
  /// Ordem do fundador (1..N). Única: impede passar do número de vagas.
  founderNumber          Int?               @unique @map("founder_number")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  /// Parcelamento do Asaas (plano anual).
  providerInstallmentId  String?            @unique @map("provider_installment_id")
  billingCycle           BillingCycle       @default(MONTHLY) @map("billing_cycle")
  installmentCount       Int?               @map("installment_count")
  billingType            String?            @map("billing_type") @db.VarChar(20)
  /// Link da cobrança em aberto (página hospedada do provedor).
  invoiceUrl             String?            @map("invoice_url")
  priceCents             Int?               @map("price_cents")
  /// Até quando o acesso vale. Nulo só em concessão manual sem prazo.
  currentPeriodEnd       DateTime?          @map("current_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  /// Motivo da concessão manual ou observação da administração.
  note                   String?
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([institutionId, status])
  @@index([source])
  @@map("subscriptions")
}

/// Contador de uso por recurso e período ("AAAA-MM" ou "AAAA-MM-DD", no fuso
/// de Brasília). O incremento é atômico e respeita o limite no próprio SQL.
model PlanUsage {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   PlanFeature
  period    String      @db.VarChar(10)
  count     Int         @default(0)
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([userId, feature, period])
  @@map("plan_usages")
}

/// Webhooks recebidos do provedor de pagamento. O provedor entrega "pelo menos
/// uma vez": o par (provider, event_id) único torna o processamento idempotente.
model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(20)
  eventId     String    @map("event_id")
  type        String    @db.VarChar(60)
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------- cadernos

enum NotebookKind {
  FORMULA
  REPERTOIRE
}

/// Coleção personalizada de um caderno (ex.: "Repertórios para educação").
/// Um item pode estar em várias coleções.
model NotebookCollection {
  id          String                     @id @default(uuid()) @db.Uuid
  userId      String                     @map("user_id") @db.Uuid
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NotebookKind
  name        String                     @db.VarChar(120)
  description String?
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  repertoires RepertoireCollectionItem[]
  formulas    FormulaCollectionItem[]

  @@index([userId, kind])
  @@map("notebook_collections")
}

model RepertoireCollectionItem {
  collectionId String             @map("collection_id") @db.Uuid
  collection   NotebookCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  repertoireId String             @map("repertoire_id") @db.Uuid
  repertoire   Repertoire         @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  addedAt      DateTime           @default(now()) @map("added_at")

  @@id([collectionId, repertoireId])
  @@index([repertoireId])
  @@map("repertoire_collection_items")
}

model FormulaCollectionItem {
  collectionId String             @map("collection_id") @db.Uuid
  collection   NotebookCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  formulaId    String             @map("formula_id") @db.Uuid
  formula      Formula            @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  addedAt      DateTime           @default(now()) @map("added_at")

  @@id([collectionId, formulaId])
  @@index([formulaId])
  @@map("formula_collection_items")
}

// ===================================================== Lumina Groups (Fase 2)
// Grupos de estudo entre alunos: comunidade, não turma institucional. Ficam
// fora de Workspace/Class, e os papéis valem só dentro do grupo
// (docs/LUMINA_GROUPS.md §4). O tempo estudado continua vindo só de
// StudyTimeLog: o grupo lê, não contabiliza.

enum StudyGroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum StudyGroupMemberStatus {
  ACTIVE
  /// Pediu para entrar num grupo com aprovação de entrada.
  PENDING
}

model StudyGroup {
  id               String             @id @default(uuid()) @db.Uuid
  name             String             @db.VarChar(80)
  description      String?            @db.VarChar(500)
  /// Propósito curto, ex.: "ENEM 2027", "Medicina", "Grupo de redação".
  purpose          String?            @db.VarChar(60)
  imageUrl         String?            @map("image_url")
  rules            String?            @db.VarChar(2000)
  /// Código de entrada; trocar o código invalida os links de convite antigos.
  joinCode         String             @unique @map("join_code") @db.VarChar(12)
  requiresApproval Boolean            @default(false) @map("requires_approval")
  maxMembers       Int                @default(30) @map("max_members")
  ownerId          String             @map("owner_id") @db.Uuid
  /// Arquivado antes da exclusão definitiva (só o dono exclui).
  archivedAt       DateTime?          @map("archived_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  owner            User               @relation("StudyGroupOwner", fields: [ownerId], references: [id])
  members          StudyGroupMember[]

  @@index([ownerId])
  @@map("study_groups")
}

/// Vínculo aluno x grupo, com papel e o que ele compartilha com os colegas.
/// Tudo começa desligado: o colega só vê nome e foto até o próprio aluno ligar.
model StudyGroupMember {
  id                String                 @id @default(uuid()) @db.Uuid
  groupId           String                 @map("group_id") @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  role              StudyGroupRole         @default(MEMBER)
  status            StudyGroupMemberStatus @default(ACTIVE)
  shareStudyTime    Boolean                @default(false) @map("share_study_time")
  shareSubjects     Boolean                @default(false) @map("share_subjects")
  shareStreak       Boolean                @default(false) @map("share_streak")
  shareLastActivity Boolean                @default(false) @map("share_last_activity")
  /// Participação no ranking (fase de engajamento). Desligada por padrão.
  rankingOptIn      Boolean                @default(false) @map("ranking_opt_in")
  joinedAt          DateTime               @default(now()) @map("joined_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  group             StudyGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("study_group_members")
}

/// Alerta pedagógico persistido (item 41). Nasce dos sinais calculados no
/// painel do professor, numa janela fixa de 30 dias, e guarda o ciclo de vida:
/// aberto → em acompanhamento → resolvido/dispensado, com histórico.
/// `fingerprint` identifica o mesmo sinal entre leituras (turma + aluno + tipo,
/// ou questão + tipo).
model PedagogicalAlert {
  id             String                 @id @default(uuid()) @db.Uuid
  teacherId      String                 @map("teacher_id") @db.Uuid
  fingerprint    String                 @db.VarChar(200)
  kind           String                 @db.VarChar(40)
  severity       String                 @db.VarChar(10)
  status         PedagogicalAlertStatus @default(OPEN)
  classId        String?                @map("class_id") @db.Uuid
  studentId      String?                @map("student_id") @db.Uuid
  questionKey    String?                @map("question_key") @db.VarChar(120)
  title          String
  detail         String
  recommendation String
  metric         Float?
  /// Fechado automaticamente porque o sinal deixou de aparecer.
  autoResolved   Boolean                @default(false) @map("auto_resolved")
  reopenCount    Int                    @default(0) @map("reopen_count")
  note           String?
  /// Trilha: [{ at, by, from, to, note? }] (by = null quando foi o sistema).
  history        Json                   @default("[]")
  firstSeenAt    DateTime               @map("first_seen_at")
  lastSeenAt     DateTime               @map("last_seen_at")
  closedAt       DateTime?              @map("closed_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  teacher        User                   @relation("PedagogicalAlertTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, fingerprint])
  @@index([teacherId, status])
  @@map("pedagogical_alerts")
}

enum PedagogicalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED

  @@map("pedagogical_alert_status")
}

/// Plano de recuperação (item 42): etapas guiadas para um assunto em que o
/// aluno tem dificuldade. Criado pelo próprio aluno ou por um professor da
/// turma dele. O progresso é calculado na leitura, a partir das respostas.
/// Ver src/recovery-plans/recovery-plan.ts.
model RecoveryPlan {
  id              String             @id @default(uuid()) @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  createdById     String             @map("created_by_id") @db.Uuid
  classId         String?            @map("class_id") @db.Uuid
  alertId         String?            @map("alert_id") @db.Uuid
  subjectId       String             @map("subject_id") @db.Uuid
  topicId         String             @map("topic_id") @db.Uuid
  subjectName     String             @map("subject_name") @db.VarChar(120)
  topicName       String             @map("topic_name") @db.VarChar(160)
  status          RecoveryPlanStatus @default(ACTIVE)
  /// [{ kind, title, questionIds, target, note? }]
  steps           Json
  /// De onde vieram as questões e quantas havia (para a tela explicar).
  poolInfo        Json               @map("pool_info")
  baselineMastery Int?               @map("baseline_mastery")
  finalMastery    Int?               @map("final_mastery")
  reviewAt        DateTime           @map("review_at")
  videoWatchedAt  DateTime?          @map("video_watched_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  student         User               @relation("RecoveryPlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("RecoveryPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([createdById])
  @@map("recovery_plans")
}

enum RecoveryPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("recovery_plan_status")
}
