# ==============================================================================
# lumina-app — variáveis de ambiente
# ==============================================================================
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA faça commit do arquivo `.env`.
# ==============================================================================

# VITE_API_URL
# URL base do lumina-backend (API de autenticação). Usada para todas as
# chamadas de login/cadastro/perfil e para montar o link do botão "Continuar
# com Google" (redireciona para VITE_API_URL/auth/google).
# Sugestão para desenvolvimento local:
VITE_API_URL=http://localhost:1000

# VITE_LANDING_URL
# URL base do lumina-landing (site institucional) — usada para o link do
# logo/voltar dentro das telas de login e cadastro.
# Sugestão para desenvolvimento local:
VITE_LANDING_URL=http://localhost:5173
